# Test image for lab-in-a-box's automated checks (tests/run_tests.sh).
# Deliberately NOT run with --systemd — see webui_service_test.sh: running
# plain (no /run/systemd/system) exercises the installer's non-systemd
# fallback path for _webui_mode=service, which is otherwise easy to leave
# untested on any dev machine that does have systemd (this project's own
# convention: never rely on the host having any particular init system).
FROM registry.opensuse.org/opensuse/leap:15.6
RUN zypper --non-interactive install --no-recommends \
        bash python3 python3-xml python311-base python311-pip systemd git tar xz curl iproute2 nodejs22 openssl apache2 sudo \
    && zypper clean --all \
    && ln -sf /usr/bin/node22 /usr/local/bin/node 2>/dev/null || ln -sf /usr/bin/node /usr/local/bin/node 2>/dev/null || true
# python311-cryptography (the zypper package) is Leap 15.6's own 41.0.3 build, which predates
# `cryptography`'s Argon2id KDF support (confirmed live 2026-09-11: that version has no
# cryptography.hazmat.primitives.kdf.argon2 module at all) — libs/crypto_store.py needs it, so
# pip-install a current version instead of the distro package. pyyaml goes ONLY into python3.11's
# own site-packages here (not plain `python3`, which stays deliberately PyYAML-less — several
# existing checks, e.g. 11_primary/44_cloud_accounts, exercise the "PyYAML is required" /
# ImportError path under python3 and must keep doing so).
RUN python3.11 -m pip install --no-cache-dir "cryptography>=42" pyyaml
WORKDIR /repo
