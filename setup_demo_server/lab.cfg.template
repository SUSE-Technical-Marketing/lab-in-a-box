#################################
#### What you should change: ####
#################################

# Network settings
_mydns=192.168.8.1
_mygw=192.168.8.1
_myip=192.168.8.71
_mynet=192.168.8.0/24          # CIDR notation — prefix is derived from this
_mydomain=mydemo.lab
_mynetrev=8.168.192

# Default SSH public key — a new one is also generated on the automation VM
# and will be shown at the end of setup
ROOT_SSH_PUB_KEY='REPLACE ME with: cat ~/.ssh/<your_key>.pub'


################################
#### What you could change: ####
################################

# Root password hash (used to set the root password inside the automation VM)
# Generate with: openssl passwd -6 'yourpassword' (the template's value is the hash of 1234)
ROOT_PWD_HASH='$6$AK9pZLzQ6G5zD5Vn$U7t.tGI9xDLqMez/kQLjziwVwxIYxpWbx./UYAVqZGvYclQHoiZ3ph1pFLvsNnz/p6H..51sLXS79Wn9IXc/r0'

# Initial plaintext root password (used with chpasswd -c SHA512)
root_pwd=1234

# Automation VM hostname
AUTOMATION_HOSTNAME='automation.mydemo.lab'

# Internal registry server
MYREG='registry.mydemo.lab'

# Source QCOW2 image — version and download URL are derived from the filename.
# NOTE: this only works for Leap 15.x's filename convention
# (openSUSE-Leap-<ver>-Minimal-VM.x86_64-...-kvm-and-xen...qcow2). Leap 16.0's
# appliance directory uses a genuinely different filename shape
# (Leap-16.0-Minimal-VM.x86_64-Cloud.qcow2 — no "openSUSE-" prefix, "Cloud"
# build variant instead of "kvm-and-xen") — if targeting Leap 16, set this to
# the real 16.x filename from download.opensuse.org yourself; it is not
# auto-derived from a 15.x-style name.
_QCOW_IMAGE=/var/lib/libvirt/images/sources/openSUSE-Leap-15.6-Minimal-VM.x86_64-kvm-and-xen.qcow2

# Timezone for the automation VM
_timezone=Europe/Zurich

# Bridge interface on the KVM host (leave empty to auto-detect)
_bridge_name=""

# NIC to enslave to _bridge_name if the bridge doesn't already exist (leave
# empty to skip bridge creation and assume one is already configured, today's
# default behavior)
_bridge_nic=""

# Networking mode for the automation VM: "bridge" (default) puts it directly
# on the KVM host's own LAN via _bridge_name/_bridge_nic above, exactly as
# today. "nat" is an EXTRA, opt-in alternative for hosts where bridging isn't
# available or wanted (e.g. a single-NIC laptop used as the hypervisor) — the
# automation VM instead gets a private IP on a new libvirt-managed NAT'd
# virtual network, and _nat_forwarded_ports below gets forwarded in from the
# host's own real IP automatically. Bridge mode is completely unaffected by
# this setting; nothing about it changes when left at "bridge".
_network_mode="bridge"

# Only used when _network_mode="nat": name/CIDR for the new libvirt virtual
# network this project defines (libvirt itself manages DHCP/gateway/NAT for
# this range once started — this is exactly libvirt's own built-in "default"
# network mechanism, just under our own name instead of reusing "default").
_nat_network_name="labnat"
_nat_network_cidr="192.168.150.0/24"

# Only used when _network_mode="nat": which of the automation VM's own ports
# get forwarded in from the KVM host's real IP, "<external>:<internal>/<protocol>"
# per entry (same syntax as a lab node's own "forwarded_ports" JSON field).
# Defaults to SSH + plain HTTP (VMs fetch their own provisioning files over
# this during boot) + HTTPS (the webui). Add "8843:8843/TCP" too if MCP_PORT
# is enabled and you want it reachable from outside the NAT'd network.
_nat_forwarded_ports="22:22/TCP 80:80/TCP 443:443/TCP"

# Extra packages to install on the KVM host, space-separated (appended to
# whichever OS+version's own package list applies; leave empty for none)
_extra_host_pkgs=""

# SLES hosts only (openSUSE Leap needs none of these — its repos are open).
# Required for the KVM host's own package installation to work at all:
# confirmed live 2026-08-29 that SUSEConnect fails outright ("Please provide
# Registration Code") on a genuinely unregistered SLES host without this.
# Leave SUSE_regcode empty only if the host is already registered by some
# other means (e.g. registered at install time).
SUSE_regcode=""
SUSE_email=""
SUSE_url=""

# How the automation node runs: "vm" (default), a libvirt VM built from _QCOW_IMAGE; "container", a privileged
# openSUSE Leap podman container on this host (setup_demo_server/automation-node.Containerfile) attached to the
# same network with the same _myip, its data on podman volumes lab-automation-*; or "kubernetes" (see below).
# setup_kvm_node.py switches "vm" to "container" when the VM cannot be built.
_automation_node="vm"

# Only used when _automation_node="kubernetes". The automation node runs as a StatefulSet with its configuration and
# user data on a persistent volume; the lab reaches it at _myip.
#   _k8s_kubeconfig     kubeconfig of the cluster (empty: kubectl's default)
#   _k8s_namespace      namespace (default lab-automation)
#   _k8s_network        "loadbalancer" (default): a LoadBalancer Service at _myip (MetalLB or the cloud's load
#                       balancer must be able to give it that address); "macvlan": a Multus macvlan interface with
#                       _myip on the cluster nodes' lab network interface _k8s_macvlan_master
#   _k8s_storage_class  storage class of the persistent volume (empty: the cluster's default)
#   _k8s_volume_size    size of the persistent volume (default 20Gi)
#   _automation_image   image to run (empty: ghcr.io/rmahique/lab-automation-node:latest)
_k8s_kubeconfig=""
_k8s_namespace="lab-automation"
_k8s_network="loadbalancer"
_k8s_macvlan_master=""
_k8s_storage_class=""
_k8s_volume_size="20Gi"
_automation_image=""

# MAC address for the automation VM (leave empty to auto-generate from _myip using QEMU OUI 52:54:00)
_automation_mac=""

# virt-install --graphics value for the automation VM. "spice" (default) falls back to
# "vnc" automatically when the host's QEMU has no spice support (virsh domcapabilities);
# "none" leaves it without a graphical console (it is managed over SSH/DNS/webui anyway).
_automation_graphics="spice"

# KVM hypervisor SSH connection for sshfs mount of source images
_virt_srv="root@hypervisor"


###############################################################
#### ADVANCED SETTINGS, unlikely needs to be changed:      ####
###############################################################

# Connection to libvirt
_qemu_addr="qemu:///system"

# Disk size for the automation VM in GB
_disk_size=40
