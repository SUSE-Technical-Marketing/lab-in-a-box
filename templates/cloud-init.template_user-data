#cloud-config
locale: en_US.UTF-8
timezone: Europe/Zurich
fqdn: ${_vm_name}
autoinstall:
  version: 1
  identity:
    hostname: ${_vm_name}
    password: "${ROOT_PWD_HASH}"
    username: ubuntu
users:
  - default
  - name: ubuntu
    ssh_authorized_keys: ["${ROOT_SSH_KEY}"]
    hashed_passwd: "${ROOT_PWD_HASH}"
  - name: root
    lock_passwd: false
    ssh_authorized_keys: ["${ROOT_SSH_KEY}"]
    hashed_passwd: "${ROOT_PWD_HASH}"
$( if [[ "${ISO_IMAGE,,}" == *ubuntu* ]]; then
cat <<CI_UBUNTU
write_files:
  - path:  /etc/netplan/50-cloud-init.yaml
    permissions: '0640'
    content: |
         network:
           version: 2
           renderer: networkd
           ethernets:
             id0:
               match:
                 macaddress: "${mymac}"
               addresses:
                 - ${myip}/${mymask}
               routes:
                 - to: 0.0.0.0/0
                   via: ${mygw}
               nameservers:
                 search: [${mydomain}]
                 addresses: [${mydns}]

runcmd:
  - grep -qF "${_vm_name}" /etc/hosts || echo "127.0.0.1 ${_vm_name} ${_vm_name%%.*}" >> /etc/hosts
  - netplan generate
  - netplan apply
CI_UBUNTU
  if [[ "${ci_options}" == *"grub_ubuntu"* ]]; then
    echo '  - ln -s /usr/sbin/grub-mkconfig /usr/sbin/grub2-mkconfig'
    echo '  - ln -s /boot/grub /boot/grub2'
    echo '  - sed "s/GRUB_TIMEOUT_STYLE.*/GRUB_TIMEOUT_STYLE=menu/;s/GRUB_TIMEOUT.*/GRUB_TIMEOUT=8/" -i /etc/default/grub -i /etc/default/grub.d/50-cloudimg-settings.cfg'
    echo '  - grub-mkconfig -o /boot/grub/grub.cfg'
  fi
else
cat <<CI_FIREWALL
runcmd:
  - grep -qF "${_vm_name}" /etc/hosts || echo "127.0.0.1 ${_vm_name} ${_vm_name%%.*}" >> /etc/hosts
  - systemctl disable --now firewalld || true
  - grep -qF "default ${mygw}" /etc/sysconfig/network/routes 2>/dev/null || printf 'default %s - -\n' "${mygw}" >> /etc/sysconfig/network/routes
  - ip route show default | grep -q . || ip route add default via ${mygw} || true
CI_FIREWALL
fi )
