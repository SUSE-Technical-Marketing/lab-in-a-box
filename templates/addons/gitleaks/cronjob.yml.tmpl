# Gitleaks scheduled scan, installed by scripts/install_gitleaks (gitleaks_mode "kubernetes").
# The init container clones the lab's repositories into an emptyDir and the Gitleaks container scans them, so the
# job needs no volume claim and nothing of the cluster. The findings are the job's own output.
apiVersion: batch/v1
kind: CronJob
metadata:
  name: gitleaks
  namespace: ${gitleaks_ns}
  labels:
    app.kubernetes.io/name: gitleaks
    app.kubernetes.io/managed-by: lab-in-a-box
spec:
  schedule: "${gitleaks_schedule}"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      template:
        metadata:
          labels:
            app.kubernetes.io/name: gitleaks
        spec:
          restartPolicy: Never
          initContainers:
            - name: clone
              image: ${gitleaks_git_image}
              command: ["sh", "-c", ${gitleaks_clone_json}]
              volumeMounts:
                - name: repos
                  mountPath: /repos
          containers:
            - name: gitleaks
              image: ${gitleaks_image}
              args: ${gitleaks_args_json}
              volumeMounts:
                - name: repos
                  mountPath: /repos
                  readOnly: true
          volumes:
            - name: repos
              emptyDir: {}
