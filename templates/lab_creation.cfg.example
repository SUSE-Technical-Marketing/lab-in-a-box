#################################
#### What you should change: ####
#################################
## This is what you need to change

## This is the public SSH key to be setup on the VMs.
ROOT_SSH_KEY='REPLACE ME with cat ~/.ssh/<your_key>.pub'

## This is the hypervisor node
REMOTE_HOST='nuc1.mydemo.lab'

## This are the credentials for registering a SUSE OS.
SUSE_email='me@mydemo.lab'
SUSE_regcode='XYZ-XYZ'


################################
#### What you could change: ####
################################
## This is what you may want to change

## This only needs to be changed if you are using Uyuni/SUSE Manager
SUSE_url='https://scc.suse.com'

## This is the password hash for the root password
ROOT_PWD_HASH='$6$AK9pZLzQ6G5zD5Vn$U7t.tGI9xDLqMez/kQLjziwVwxIYxpWbx./UYAVqZGvYclQHoiZ3ph1pFLvsNnz/p6H..51sLXS79Wn9IXc/r0' # this example is 1234

## This is the initial rancher password
rancher_initial_pwd=abc1234

## Internal registry server to use
MYREG='registry.mydemo.lab'

## This is the url to connect to libvirt in the hypervisor node.
VIRT_SRV="qemu+ssh://root@${REMOTE_HOST}/system?keyfile=.ssh/id_rsa"

## This is the hostname of the lab automation server.
mysource='automation.mydemo.lab'


###############################################################
#### ADVANCED SETTINGS, this unlikely needs to be changed: ####
###############################################################
## You can replace the defaults found inside lab_creation.defaults by defining them in this file.

## Add or change the packages that will get installed at the beginning.
## ID and VERSION_ID should match those inside /etc/os-release
#_BOOT_PACKAGES["<ID>-<VERSION_ID>"]="vim-small iptables NetworkManager-cloud-setup wget git"

## path for the library
#_lib_path=/usr/local/lib/lab_creation/lab_creation.bash
#_templ_addons_loc=/usr/share/lab_creation/templates/addons/

## The delay between stages, increase if load is high or resources are low. The current should work with "normal" hardware
#delay_min="2"
#delay_sec="$((60 * $delay_min))"

## This is the source path for the lab automation scripts that maybe used during the combustion phase.
#sourcepath=/lab_creation/scripts/

## This is the path for the materials of the lab that will be retrieved via HTTP
#LAB_SETUP_PATH="/srv/www/htdocs/lab_creation"

## This is where the VM disk images will be placed
#VM_IMG_LOC='/var/lib/libvirt/images/'

## This is the location of the source images used to build the VMs
#ISO_LOC='/var/lib/libvirt/images/sources'

## Required only if some node/cluster uses common.backend or nodes.<x>.backend
## = "harvester" — path to a kubeconfig for an already-running Harvester
## cluster this tool will provision guest VMs on instead of a KVM
## hypervisor. HarvesterBackend v1 only supports config_method="cloud-init"
## and does not auto-import VM images — pre-import a VirtualMachineImage
## named after ISO_IMAGE in Harvester before deploying. Live-tested
## against real Harvester clusters (ISO- and PXE-installed) — see
## libs/backends.py's HarvesterBackend docstring for exactly what was
## verified and what wasn't.
#HARVESTER_KUBECONFIG='/etc/lab-harvester/kubeconfig'

## Harvester namespace guest VMs are created in (default: "default")
#HARVESTER_NAMESPACE='default'

## Pre-existing Multus NetworkAttachmentDefinition ("<namespace>/<name>", or
## a bare name for one in HARVESTER_NAMESPACE) guest VMs attach to instead
## of KubeVirt's default pod network. Required for a real LAN-routable IP
## (matching this project's DNS/SSH conventions) — omitting it keeps VMs on
## the pod network, reachable only via kubectl/virtctl, never DNS/SSH.
## HarvesterBackend does not create the underlying Harvester VLAN network
## (ClusterNetwork/VlanConfig/NetworkAttachmentDefinition) itself — that's a
## one-time, cluster-level physical-network decision, set it up in Harvester
## first (same "pre-configure it yourself" stance as the VM image above).
#HARVESTER_NETWORK='default/mgmt-vlan'

## MCP (Model Context Protocol) endpoint — lets an MCP client (an LLM agent)
## drive lab-in-a-box. Runs as its own root-owned service, separate from the
## webui. Off (read-only tools only) unless MCP_ALLOW_MUTATIONS is set.
#MCP_PORT=8843
#MCP_BIND=0.0.0.0

## Set to "true" to let the MCP endpoint's deploy_lab/rebuild_lab/
## destroy_lab/destroy_vm tools run real deploy/destroy operations. Every
## call still requires an exact target-identifier "confirm" string — this
## just controls whether those tools exist at all. Default: unset (false) —
## the endpoint is read-only until you opt in.
#MCP_ALLOW_MUTATIONS=false

## Where every MCP tool call (accepted or rejected) gets logged, one JSON
## object per line.
#MCP_AUDIT_LOG=/var/log/lab-mcp/audit.log

## Cross-cloud WireGuard overlay (libs/overlay.py) — used only when a lab's
## JSON sets common.overlay=true. Names the hub via OVERLAY_HUB_HOST (an
## already-running, reachable host you designate yourself — e.g. this
## automation VM, or any existing cloud VM — turned into the hub in place),
## OVERLAY_HUB_ACCOUNT (a cloud account name under CREDENTIALS_PATH — a
## dedicated small hub VM is auto-created/reused there, named
## "lab-overlay-hub-<backend>[-<account>]", the same reuse-across-runs
## convention as the cloud DNS VM), or BOTH: an existing host (HUB_HOST)
## plus the account that owns it (HUB_ACCOUNT) — this is what makes the
## cloud firewall/security-group port-opening automatic for an existing
## host too, instead of a manual step (HUB_HOST alone never touches the
## cloud API at all, on purpose, for a host on a backend you have no
## account configured for). HUB_HOST alone (no HUB_ACCOUNT) is fine for a
## non-cloud host, or when the port is already open by other means.
#OVERLAY_HUB_HOST=
#OVERLAY_HUB_ACCOUNT=

## Overlay network CIDR — the hub always takes the first usable address
## (10.99.0.1 for the default below). Every spoke gets one address from
## this range, allocated sequentially and tracked on the hub itself.
#OVERLAY_CIDR=10.99.0.0/16

## UDP port the hub's WireGuard listens on — opened automatically on a
## cloud-created hub's security group; open it yourself if OVERLAY_HUB_HOST
## points at an existing host behind its own firewall.
#OVERLAY_WG_PORT=51820



