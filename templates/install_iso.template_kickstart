#version=RHEL8
text
reboot

# Locale / keyboard
lang en_US.UTF-8
keyboard us
timezone UTC --utc

# Network
network --bootproto=static --ip=$myip --netmask=$(python3 -c "import ipaddress; print(ipaddress.IPv4Network('0.0.0.0/$mymask',False).netmask)" 2>/dev/null || echo 255.255.255.0) --gateway=$mygw --nameserver=$mydns --hostname=$_vm_name --activate

# Disk
zerombr
clearpart --all --initlabel
autopart --type=lvm

# Root password (pre-hashed)
rootpw --iscrypted $ROOT_PWD_HASH

# SSH
services --enabled=sshd
sshkey --username=root "$ROOT_SSH_PUBKEY"

# Minimal package set
%packages --ignoremissing
@^minimal-environment
openssh-server
%end

%post
sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
%end
