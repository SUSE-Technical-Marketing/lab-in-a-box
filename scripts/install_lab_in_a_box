#!/usr/bin/env python3.11
# Part of lab-in-a-box, it will install lab-in-a-box itself (https://github.com/SUSE-Technical-Marketing/lab-in-a-box)
# on the target node, so a lab can bootstrap another lab-in-a-box host/automation-node from inside a running lab.
# Author/s: Raul Mahiques
# License: GPLv3
#
# Schema version: 1.0
#
# JSON section: "lab_in_a_box" — Installs lab-in-a-box itself on the target node
#   lab_in_a_box_install_url : [OPTIONAL] URL of install_demo_server_scripts.sh to fetch and run on the target node
#                              (default: https://raw.githubusercontent.com/SUSE-Technical-Marketing/lab-in-a-box/main/install_demo_server_scripts.sh)
#   lab_in_a_box_args        : [OPTIONAL] list of args passed through to install_demo_server_scripts.sh —
#                              installs git+python and clones the repo without building anything by
#                              default; pass e.g. ["-y"] instead to build a nested KVM host unattended
#                              (default: ["--fetch-only"])
#
# Target node(s): any node listing "lab_in_a_box" in its own addons[] list — same dispatch shape as
# install_client_registration.py. This only installs the tool (idempotent: a no-op if already present);
# actually building a nested KVM host with it is the operator's deliberate next step by default, not
# something this addon does on its own — see libs/lab_in_a_box_common.py's own docstring for why.

__version__ = "__LABVERSION__"

PLUGIN = {
    "name": "lab_in_a_box",
    "targets": ["vm", "baremetal"],
    "layers": ["os-native"],
    "requires_kubernetes": None,
    "aux_services": [],
    "check": True,
}

import os
import sys
from pathlib import Path

for _candidate in ("/usr/local/lib/lab_creation", str(Path(__file__).resolve().parent.parent / "libs")):
    if Path(_candidate).is_dir() and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

import addon_common as ac  # noqa: E402
import k8s  # noqa: E402
import primary  # noqa: E402
from lab_in_a_box_common import DEFAULT_INSTALL_URL, install_lab_in_a_box, lab_in_a_box_installed  # noqa: E402


def _validate(v):
    v.vurl_field("lab_in_a_box", "lab_in_a_box_install_url")
    args = (v.definition.get("lab_in_a_box", {}) or {}).get("lab_in_a_box_args")
    if args is not None and (not isinstance(args, list) or not all(isinstance(a, str) for a in args)):
        v.errors.append("[ERROR] lab_in_a_box.lab_in_a_box_args must be a list of strings")


def check_lab_in_a_box(c):
    if lab_in_a_box_installed(c.vm_name):
        c.ok("lab-in-a-box is installed on '{}'".format(c.vm_name))
    else:
        c.fail("lab-in-a-box is not installed on '{}'".format(c.vm_name))


def main():
    ac.handle_common_args(__file__, __version__, validate_fn=_validate, plugin=PLUGIN, check_fn=check_lab_in_a_box)

    if len(sys.argv) < 2:
        print("Usage: {} <lab.json>".format(Path(sys.argv[0]).name))
        sys.exit(1)
    definition = primary.load_definition(sys.argv[1])

    env_vm_name = os.environ.get("_vm_name") or None
    for vm_name, _ssh_cmd in k8s.addon_nodes(definition, "lab_in_a_box", vm_name=env_vm_name):
        cfg = k8s.addon_node_config(definition, "lab_in_a_box", vm_name)
        if lab_in_a_box_installed(vm_name):
            print("- lab-in-a-box is already installed on '{}'".format(vm_name))
            continue
        install_url = cfg.get("lab_in_a_box_install_url") or DEFAULT_INSTALL_URL
        install_lab_in_a_box(vm_name, install_url, cfg.get("lab_in_a_box_args"))


if __name__ == "__main__":
    main()
