#!/usr/bin/env python3.11
# Part of lab-in-a-box, it will install Anthropic's own client tooling on a lab node: the Claude Code CLI, the
# Claude Agent SDK, the Anthropic API SDK and the `ant` Claude Platform CLI
# Author/s: Raul Mahiques
# License: GPLv3
#
# Schema version: 1.0
#
# JSON section: "anthropic_tools" — Anthropic's client tooling on a node
#   anthropic_tools_components : [OPTIONAL] list of what to install (default: ["claude_code"]). "claude_code" the
#                            Claude Code CLI; "agent_sdk" the Claude Agent SDK for Python and Node; "api_sdk" the
#                            Anthropic API SDK for Python and Node; "ant_cli" the `ant` Claude Platform CLI, built
#                            with Go; "settings" Claude Code's own configuration, from the fields below
#   anthropic_tools_install_method : [OPTIONAL] how the Claude Code CLI is installed: "native" runs Anthropic's own
#                            installer and auto-updates, but is per-user by design; "package" installs the signed
#                            claude-code package from Anthropic's repository, machine-wide for every user and
#                            without auto-updates (options: native, package) (default: native)
#   anthropic_tools_users  : [OPTIONAL] list of existing users to install for (default: ["root"]). The "native"
#                            method installs once per user; "package" installs once for everyone, and this is then
#                            only who gets the SDKs, the settings and the credential
#   anthropic_tools_release : [OPTIONAL] "latest" or "stable" release channel, or an exact Claude Code version such
#                            as 2.1.89, which only the "native" method can pin (default: latest)
#   anthropic_tools_path   : [OPTIONAL] "true"/"false" — add the installed binaries' directories to each user's
#                            ~/.bashrc, which neither installer does itself (options: true, false) (default: true)
#   anthropic_tools_install_url : [OPTIONAL] the native installer (default: https://claude.ai/install.sh)
#   anthropic_tools_repo_url : [OPTIONAL] base URL of the signed package repositories
#                            (default: https://downloads.claude.ai/claude-code)
#   anthropic_tools_disable_autoupdate : [OPTIONAL] "true"/"false" — set DISABLE_AUTOUPDATER, so a pinned or
#                            air-gapped node's binary never changes under it (options: true, false)
#                            (default: false)
#   anthropic_tools_model  : [OPTIONAL] the model Claude Code uses on this node, e.g. claude-opus-5
#   anthropic_tools_mcp_servers : [OPTIONAL] object of MCP servers registered in each user's own scope, each value
#                            the server definition `claude mcp add-json` takes, e.g.
#                            {"lab": {"command": "/usr/local/bin/lab-mcp", "args": ["--stdio"]}}
#   anthropic_tools_settings : [OPTIONAL] object merged into ~/.claude/settings.json for the settings the fields
#                            above do not name. The named fields win over the same key here, and only the keys this
#                            add-on sets are rewritten, so the rest of an existing settings.json survives
#   anthropic_tools_oauth_token : [OPTIONAL] a `claude setup-token` subscription token, written to the node as
#                            CLAUDE_CODE_OAUTH_TOKEN
#   anthropic_tools_api_key : [OPTIONAL] a Claude Console API key, written to the node as ANTHROPIC_API_KEY. Claude
#                            Code prefers it over a subscription token, so set one or the other
#   anthropic_tools_anthropic_account : [OPTIONAL] name of an "anthropic" credential file holding
#                            anthropic_oauth_token/anthropic_api_key, instead of either field above (one such file
#                            in the store is found on its own). Prefer this: those two fields put a live credential
#                            in the lab definition in plain text
#
#   The three credential fields are entirely optional and unset by default. Claude Code is normally logged in by
#   whoever uses it, with `claude` on the node, or with `claude setup-token` on a machine that has a browser and
#   CLAUDE_CODE_OAUTH_TOKEN exported on the node afterwards, and this add-on installs the tooling with no
#   credential at all. A credential configured here is written 0600 for each user, to Claude Code's own settings
#   when the CLI is installed and to a ~/.claude/anthropic_tools.env sourced from ~/.bashrc when a component that
#   reads the environment is installed (the SDKs and ant do, Claude Code's settings do not).
#
#   The "anthropic" add-on is unrelated: it is a LiteLLM proxy in front of the Anthropic API on a kcluster, and
#   shares nothing with this but the vendor's name.
#
# Target node(s): every node listing "anthropic_tools" in its own addons[] list, each node's config read through
# k8s.addon_node_config(). No Kubernetes cluster is involved.
#
# The native installer is per-user by design: it writes ~/.local/bin/claude and ~/.local/share/claude/versions/ in
# the home of the user that runs it and nothing outside it, so one user's install is not another's, and Anthropic
# documents no machine-wide variant of it. The signed package is the machine-wide route. Anthropic publishes that
# rpm repository for Fedora and RHEL; zypper reads the very same repository, which is the route on SLES and
# openSUSE, and the package manager's own error is reported as it comes when a dependency the package declares is
# named differently there.

__version__ = "__LABVERSION__"

PLUGIN = {
    "name": "anthropic_tools",
    "targets": ["vm", "baremetal"],
    "layers": ["os-native"],
    "requires_kubernetes": None,
    "aux_services": [],
    "check": True,
}

import json
import os
import shlex
import sys
from pathlib import Path

for _candidate in ("/usr/local/lib/lab_creation", str(Path(__file__).resolve().parent.parent / "libs")):
    if Path(_candidate).is_dir() and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

import addon_common as ac  # noqa: E402
import k8s  # noqa: E402
from agents import as_user, claude_command, register_mcp_servers  # noqa: E402
import primary  # noqa: E402
from nodejs import ensure_node, first_available, npm_command  # noqa: E402,F401
from lab_creation import (die, install_packages, package_available, package_manager, require_ssh,  # noqa: E402
                          ssh_run)

COMPONENTS = ("claude_code", "agent_sdk", "api_sdk", "ant_cli", "settings")
DEFAULT_COMPONENTS = ("claude_code",)
METHODS = ("native", "package")
CHANNELS = ("latest", "stable")
DEFAULT_INSTALL_URL = "https://claude.ai/install.sh"
DEFAULT_REPO_URL = "https://downloads.claude.ai/claude-code"
RPM_KEY_URL = "https://downloads.claude.ai/keys/claude-code.asc"
APK_KEY_URL = "https://downloads.claude.ai/keys/claude-code.rsa.pub"
PACKAGE = "claude-code"
SETTINGS_FILE = ".claude/settings.json"
ENV_FILE = ".claude/anthropic_tools.env"
# Components whose tooling reads the credential from the environment rather than from Claude Code's own settings.
ENV_COMPONENTS = ("agent_sdk", "api_sdk", "ant_cli")

# The packages each component needs, named as each package manager's own distribution names them. A tuple holds
# alternatives, tried in order against the node's repositories, for a distribution that carries none of the others.
PIP_PACKAGES = {
    "zypper": (["python3-pip"],), "transactional-update": (["python3-pip"],), "dnf": (["python3-pip"],),
    "yum": (["python3-pip"],), "apt-get": (["python3-pip"],), "apk": (["py3-pip"],),
}
GO_PACKAGES = {
    "zypper": (["go"],), "transactional-update": (["go"],), "dnf": (["golang"],), "yum": (["golang"],),
    "apt-get": (["golang-go"],), "apk": (["go"],),
}

AGENT_SDK_PIP = "claude-agent-sdk"
AGENT_SDK_NPM = "@anthropic-ai/claude-agent-sdk"
API_SDK_PIP = "anthropic"
API_SDK_NPM = "@anthropic-ai/sdk"
ANT_PACKAGE = "github.com/anthropics/anthropic-cli/v2/cmd/ant@latest"
# Upstream's own documented PATH line for a Go install, written as it stands so the shell resolves GOPATH itself.
GO_PATH_LINE = 'export PATH="$PATH:$(go env GOPATH)/bin"'
CLAUDE_PATH_LINE = 'export PATH="$HOME/.local/bin:$PATH"'
ENV_SOURCE_LINE = '[ -f "$HOME/{}" ] && . "$HOME/{}"'.format(ENV_FILE, ENV_FILE)


def _is_true(value, default: bool = False) -> bool:
    """A JSON "true"/"false" field as a bool; an unset or empty field keeps `default`."""
    if value is None or str(value) == "":
        return default
    return str(value).strip().lower() == "true"


def _as_list(value, default=()) -> list:
    """A field that holds a list, a comma- or space-separated string, or nothing, as a list of strings."""
    if value is None or value == "":
        return list(default)
    if isinstance(value, (list, tuple)):
        return [str(v).strip() for v in value if str(v).strip()]
    return [v for v in str(value).replace(",", " ").split() if v]


def components(cfg: dict) -> list:
    """The components to install on a node, in COMPONENTS order so their prerequisites install once each."""
    wanted = _as_list(cfg.get("anthropic_tools_components"), DEFAULT_COMPONENTS)
    return [c for c in COMPONENTS if c in wanted]


def install_users(cfg: dict) -> list:
    """The users to install for, each an existing account on the node."""
    return _as_list(cfg.get("anthropic_tools_users"), ("root",))


def release(cfg: dict) -> str:
    """The release the node installs: a CHANNELS channel, or an exact Claude Code version."""
    return str(cfg.get("anthropic_tools_release") or "latest").strip()


def method(cfg: dict) -> str:
    """Which route installs the Claude Code CLI: "native" or "package"."""
    return str(cfg.get("anthropic_tools_install_method") or "native").strip().lower()


def channel(cfg: dict) -> str:
    """The repository channel for the "package" method: the release when it names one, else "latest"."""
    rel = release(cfg)
    return rel if rel in CHANNELS else "latest"


def _validate(v):
    cfg = v.definition.get("anthropic_tools", {}) or {}
    unknown = [c for c in _as_list(cfg.get("anthropic_tools_components"), DEFAULT_COMPONENTS) if c not in COMPONENTS]
    if unknown:
        v.errors.append("[ERROR] anthropic_tools.anthropic_tools_components {}: must be one of {}".format(
            ", ".join(unknown), ", ".join(COMPONENTS)))
    if method(cfg) not in METHODS:
        v.errors.append("[ERROR] anthropic_tools.anthropic_tools_install_method='{}': must be one of {}".format(
            cfg.get("anthropic_tools_install_method"), ", ".join(METHODS)))
    if method(cfg) == "package" and release(cfg) not in CHANNELS:
        v.errors.append("[ERROR] anthropic_tools.anthropic_tools_release='{}': the 'package' method installs "
                        "whatever version a channel currently holds, so it takes one of {} — an exact version "
                        "needs anthropic_tools_install_method 'native'".format(release(cfg), ", ".join(CHANNELS)))
    for field in ("anthropic_tools_path", "anthropic_tools_disable_autoupdate"):
        v.vbool("anthropic_tools", field)
    v.vurl_field("anthropic_tools", "anthropic_tools_install_url")
    v.vurl_field("anthropic_tools", "anthropic_tools_repo_url")
    for field in ("anthropic_tools_settings", "anthropic_tools_mcp_servers"):
        if cfg.get(field) and not isinstance(cfg[field], dict):
            v.errors.append("[ERROR] anthropic_tools.{} must be an object".format(field))
    comps = components(cfg)
    for field in ("anthropic_tools_settings", "anthropic_tools_model", "anthropic_tools_mcp_servers",
                  "anthropic_tools_disable_autoupdate"):
        if cfg.get(field) and "settings" not in comps:
            v.errors.append("[ERROR] anthropic_tools.{} is Claude Code's own configuration, so it needs "
                            "'settings' in anthropic_tools_components".format(field))
    if cfg.get("anthropic_tools_mcp_servers") and "claude_code" not in comps:
        v.errors.append("[ERROR] anthropic_tools.anthropic_tools_mcp_servers needs 'claude_code' in "
                        "anthropic_tools_components: Claude Code itself registers them, in its own scope")
    if cfg.get("anthropic_tools_oauth_token") and cfg.get("anthropic_tools_api_key"):
        v.errors.append("[ERROR] anthropic_tools: set anthropic_tools_oauth_token or anthropic_tools_api_key, not "
                        "both — Claude Code prefers the API key and would never use the subscription token")


# ── Pure command and payload builders ────────────────────────────────────────

def native_command(cfg: dict) -> str:
    """The command that fetches Anthropic's installer and runs it for the release this node installs."""
    url = str(cfg.get("anthropic_tools_install_url") or DEFAULT_INSTALL_URL)
    return "curl -fsSL {} | bash -s {}".format(shlex.quote(url), shlex.quote(release(cfg)))


def profile_line_command(line: str) -> str:
    """The command that leaves `line` in ~/.bashrc exactly once, whether it is already there or not."""
    quoted = shlex.quote(line)
    return 'grep -qxF {0} "$HOME/.bashrc" 2>/dev/null || printf "%s\\n" {0} >> "$HOME/.bashrc"'.format(quoted)


def write_file_command(rel_path: str, mode: str = "600") -> str:
    """The command that writes stdin to `rel_path` under the running user's home, at `mode`, creating its directory."""
    path = '"$HOME"/{}'.format(shlex.quote(rel_path))
    return 'mkdir -p "$(dirname {0})" && umask 077 && cat > {0} && chmod {1} {0}'.format(path, mode)


def repo_key_command(manager: str, repo_key_url: str = RPM_KEY_URL, apk_key_url: str = APK_KEY_URL) -> str:
    """The command that trusts Anthropic's repository signing key, as `manager`'s own distribution family trusts keys."""
    if manager in ("zypper", "transactional-update", "dnf", "yum"):
        return "rpm --import {}".format(shlex.quote(repo_key_url))
    if manager == "apt-get":
        return ("install -d -m 0755 /etc/apt/keyrings && curl -fsSL {} -o "
                "/etc/apt/keyrings/claude-code.asc".format(shlex.quote(repo_key_url)))
    if manager == "apk":
        return "wget -O /etc/apk/keys/claude-code.rsa.pub {}".format(shlex.quote(apk_key_url))
    return ""


def repo_file(manager: str, repo_url: str, chan: str):
    """(path, content) of the repository definition for `manager`, or (\"\", \"\") when it has no such file."""
    if manager in ("zypper", "transactional-update", "dnf", "yum"):
        path = ("/etc/zypp/repos.d/claude-code.repo" if manager in ("zypper", "transactional-update")
                else "/etc/yum.repos.d/claude-code.repo")
        return path, ("[claude-code]\n"
                      "name=Claude Code\n"
                      "baseurl={}/rpm/{}\n"
                      "enabled=1\n"
                      "gpgcheck=1\n"
                      "gpgkey={}\n".format(repo_url, chan, RPM_KEY_URL))
    if manager == "apt-get":
        return "/etc/apt/sources.list.d/claude-code.list", (
            "deb [signed-by=/etc/apt/keyrings/claude-code.asc] {}/apt/{} {} main\n".format(repo_url, chan, chan))
    return "", ""


def apk_repo_command(repo_url: str, chan: str) -> str:
    """The command that leaves Anthropic's apk repository in /etc/apk/repositories exactly once."""
    line = "{}/apk/{}".format(repo_url, chan)
    quoted = shlex.quote(line)
    return 'grep -qxF {0} /etc/apk/repositories || printf "%s\\n" {0} >> /etc/apk/repositories'.format(quoted)


def pip_command(package: str) -> str:
    """The command that installs `package` for the running user, including on an externally-managed Python."""
    quoted = shlex.quote(package)
    return ("python3 -m pip install --user {0} || "
            "python3 -m pip install --user --break-system-packages {0}".format(quoted))


def go_command(package: str = ANT_PACKAGE) -> str:
    """The command that builds `package` into the running user's Go bin directory."""
    return "go install {}".format(shlex.quote(package))


def credential_env(creds: dict) -> dict:
    """The environment variables a resolved "anthropic" credential sets, empty when none was configured."""
    env = {}
    if (creds or {}).get("anthropic_oauth_token"):
        env["CLAUDE_CODE_OAUTH_TOKEN"] = str(creds["anthropic_oauth_token"])
    if (creds or {}).get("anthropic_api_key"):
        env["ANTHROPIC_API_KEY"] = str(creds["anthropic_api_key"])
    return env


def env_file_content(env: dict) -> str:
    """`env` as a file the shell sources, one exported variable per line."""
    return "".join("export {}={}\n".format(name, shlex.quote(value)) for name, value in sorted(env.items()))


def merge_settings(existing: dict, payload: dict) -> dict:
    """`payload` over `existing`: an object merges key by key, anything else replaces, everything else is kept."""
    merged = dict(existing or {})
    for key, value in (payload or {}).items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            nested = dict(merged[key])
            nested.update(value)
            merged[key] = nested
        else:
            merged[key] = value
    return merged


def settings_payload(cfg: dict, env: dict = None) -> dict:
    """
    The keys this add-on writes to ~/.claude/settings.json: anthropic_tools_settings as the base, with the named
    fields and any credential environment over it, so a field always wins over the same key in that object.

    An update channel is written only when anthropic_tools_release names one, so a node that was never told which
    channel to follow keeps whatever the installer chose for it.
    """
    named = {}
    if _is_true(cfg.get("anthropic_tools_disable_autoupdate")):
        named["env"] = {"DISABLE_AUTOUPDATER": "1"}
    if cfg.get("anthropic_tools_model"):
        named["model"] = str(cfg["anthropic_tools_model"])
    if method(cfg) == "native" and str(cfg.get("anthropic_tools_release") or "") in CHANNELS:
        named["autoUpdatesChannel"] = release(cfg)
    for name, value in sorted((env or {}).items()):
        named["env"] = dict(named.get("env") or {}, **{name: value})
    return merge_settings(dict(cfg.get("anthropic_tools_settings") or {}), named)


# ── Node-side steps ──────────────────────────────────────────────────────────

def ensure_prerequisites(host: str, comps: list, install_method: str, manager: str) -> None:
    """Install what the selected components need from the node's own repositories, each package named as it names it."""
    if "claude_code" in comps and install_method == "native":
        if ssh_run(host, "command -v curl", check=False, capture=True).returncode != 0:
            install_packages(host, ["curl"], manager=manager)
    if "agent_sdk" in comps or "api_sdk" in comps:
        install_packages(host, first_available(host, PIP_PACKAGES.get(manager), manager), manager=manager)
        ensure_node(host, manager)
    if "ant_cli" in comps:
        install_packages(host, first_available(host, GO_PACKAGES.get(manager), manager), manager=manager)


def install_native(host: str, user: str, cfg: dict) -> None:
    """Run Anthropic's own installer as `user`, whose home is the only place it writes."""
    print("- Installing the Claude Code CLI for '{}' on '{}'".format(user, host))
    ssh_run(host, as_user(user, native_command(cfg)))


def install_package(host: str, cfg: dict, manager: str) -> None:
    """Install the signed claude-code package machine-wide from Anthropic's own repository."""
    repo_url = str(cfg.get("anthropic_tools_repo_url") or DEFAULT_REPO_URL).rstrip("/")
    chan = channel(cfg)
    print("- Installing the {} package on '{}' from {} ({} channel)".format(PACKAGE, host, repo_url, chan))
    key = repo_key_command(manager)
    if not key:
        die("anthropic_tools_install_method 'package' needs a package manager Anthropic publishes a repository for "
            "(zypper, dnf, yum, apt-get or apk); '{}' has {}".format(host, manager))
    ssh_run(host, key)
    path, content = repo_file(manager, repo_url, chan)
    if path:
        ssh_run(host, "mkdir -p {} && cat > {}".format(shlex.quote(str(Path(path).parent)), shlex.quote(path)),
                input_text=content)
    if manager == "apk":
        ssh_run(host, apk_repo_command(repo_url, chan))
    extra = "--gpg-auto-import-keys" if manager in ("zypper", "transactional-update") else ""
    install_packages(host, [PACKAGE], manager=manager, extra_args=extra)


def install_sdks(host: str, user: str, comps: list) -> None:
    """Install the selected SDKs and CLIs for `user`, each from its own language's package manager."""
    for component, pip_pkg, npm_pkg in (("agent_sdk", AGENT_SDK_PIP, AGENT_SDK_NPM),
                                        ("api_sdk", API_SDK_PIP, API_SDK_NPM)):
        if component in comps:
            print("- Installing {} and {} for '{}' on '{}'".format(pip_pkg, npm_pkg, user, host))
            ssh_run(host, as_user(user, pip_command(pip_pkg)))
            ssh_run(host, as_user(user, npm_command(user, npm_pkg)))
    if "ant_cli" in comps:
        print("- Building the ant CLI for '{}' on '{}'".format(user, host))
        ssh_run(host, as_user(user, go_command()))


def ensure_paths(host: str, user: str, comps: list, install_method: str) -> None:
    """Put the directories the installed binaries live in on `user`'s PATH, which neither installer does itself."""
    lines = []
    if "claude_code" in comps and install_method == "native":
        lines.append(CLAUDE_PATH_LINE)
    if "agent_sdk" in comps or "api_sdk" in comps:
        lines.append(CLAUDE_PATH_LINE)
    if "ant_cli" in comps:
        lines.append(GO_PATH_LINE)
    for line in dict.fromkeys(lines):
        ssh_run(host, as_user(user, profile_line_command(line)))


def write_env_file(host: str, user: str, env: dict) -> None:
    """Write `env` 0600 under `user`'s home and source it from ~/.bashrc, for the tooling that reads the environment."""
    print("- Writing the configured credential to ~/{} for '{}' on '{}'".format(ENV_FILE, user, host))
    ssh_run(host, as_user(user, write_file_command(ENV_FILE)), input_text=env_file_content(env))
    ssh_run(host, as_user(user, profile_line_command(ENV_SOURCE_LINE)))


def read_settings(host: str, user: str) -> dict:
    """`user`'s current ~/.claude/settings.json, or {} when it is absent or not an object."""
    result = ssh_run(host, as_user(user, 'cat "$HOME/{}"'.format(SETTINGS_FILE)), check=False, capture=True)
    if result.returncode != 0:
        return {}
    try:
        current = json.loads(result.stdout or "{}")
    except ValueError:
        print("  WARNING: ~/{} of '{}' on '{}' is not valid JSON; it is left as it is and this add-on's own "
              "settings are not written".format(SETTINGS_FILE, user, host))
        return None
    return current if isinstance(current, dict) else {}


def write_settings(host: str, user: str, cfg: dict, env: dict) -> None:
    """Merge this add-on's settings into `user`'s own ~/.claude/settings.json, leaving every other key it holds."""
    payload = settings_payload(cfg, env)
    if not payload:
        return
    current = read_settings(host, user)
    if current is None:
        return
    print("- Writing ~/{} for '{}' on '{}'".format(SETTINGS_FILE, user, host))
    ssh_run(host, as_user(user, write_file_command(SETTINGS_FILE)),
            input_text=json.dumps(merge_settings(current, payload), indent=2) + "\n")


def report_claude(host: str, user: str) -> None:
    """Print the installed Claude Code version for `user`, or die when the CLI it just installed does not answer."""
    result = ssh_run(host, as_user(user, claude_command("--version")), check=False, capture=True)
    if result.returncode != 0:
        die("the Claude Code CLI was installed for '{}' on '{}' but 'claude --version' failed: {}".format(
            user, host, (result.stderr or result.stdout or "").strip()))
    print("  {} ready for '{}' on '{}'".format((result.stdout or "").strip() or "Claude Code", user, host))


def setup_anthropic_tools(host: str, cfg: dict, env: dict) -> None:
    """Install the components `cfg` selects on `host`, for each of its users, and configure what it asks for."""
    comps = components(cfg)
    if not comps:
        print("- Nothing to install on '{}': anthropic_tools_components is empty".format(host))
        return
    install_method = method(cfg)
    manager = package_manager(host)
    ensure_prerequisites(host, comps, install_method, manager)

    if "claude_code" in comps and install_method == "package":
        install_package(host, cfg, manager)

    for user in install_users(cfg):
        if "claude_code" in comps:
            if install_method == "native":
                install_native(host, user, cfg)
            report_claude(host, user)
        install_sdks(host, user, comps)
        if _is_true(cfg.get("anthropic_tools_path"), True):
            ensure_paths(host, user, comps, install_method)
        if env and [c for c in ENV_COMPONENTS if c in comps]:
            write_env_file(host, user, env)
        if "settings" in comps or (env and "claude_code" in comps):
            write_settings(host, user, cfg, env if "claude_code" in comps else {})
        if "settings" in comps and "claude_code" in comps:
            register_mcp_servers(host, user, cfg.get("anthropic_tools_mcp_servers") or {})
    if not env and "claude_code" in comps:
        print("  No credential was configured: run 'claude' on the node to log in, or export "
              "CLAUDE_CODE_OAUTH_TOKEN from a 'claude setup-token' run on a machine with a browser")


def check_anthropic_tools(c):
    """Report whether every selected component answers on the node, for each user it was installed for."""
    if not c.vm_name:
        c.fail("no target node to check: $_vm_name names none")
        return
    cfg = k8s.addon_node_config(c.definition, "anthropic_tools", c.vm_name)
    comps = components(cfg)
    if not comps:
        c.ok("this node installs no anthropic_tools component, so there is nothing to check")
        return
    for user in install_users(cfg):
        if "claude_code" in comps:
            result = ssh_run(c.vm_name, as_user(user, claude_command("--version")), check=False, capture=True)
            if result.returncode != 0:
                c.fail("the Claude Code CLI does not answer for '{}' on '{}'".format(user, c.vm_name))
            else:
                c.ok("the Claude Code CLI is installed for '{}' on '{}' ({})".format(
                    user, c.vm_name, (result.stdout or "").strip()))
        if "ant_cli" in comps:
            result = ssh_run(c.vm_name, as_user(user, '"$(go env GOPATH)"/bin/ant --version'),
                             check=False, capture=True)
            if result.returncode != 0:
                c.fail("the ant CLI does not answer for '{}' on '{}'".format(user, c.vm_name))
            else:
                c.ok("the ant CLI is installed for '{}' on '{}'".format(user, c.vm_name))
        for component, module in (("agent_sdk", "claude_agent_sdk"), ("api_sdk", "anthropic")):
            if component in comps:
                result = ssh_run(c.vm_name, as_user(user, "python3 -c 'import {}'".format(module)),
                                 check=False, capture=True)
                if result.returncode != 0:
                    c.fail("the {} Python module is not importable for '{}' on '{}'".format(
                        module, user, c.vm_name))
                else:
                    c.ok("the {} Python module is installed for '{}' on '{}'".format(module, user, c.vm_name))


def usage() -> str:
    return ("Usage: install_anthropic_tools <lab.json>\n"
            "       Installs Anthropic's client tooling on every node listing \"anthropic_tools\" in its addons[]:\n"
            "       the Claude Code CLI, the Claude Agent SDK, the Anthropic API SDK and the ant CLI.\n")


def main():
    ac.handle_common_args(__file__, __version__, validate_fn=_validate, usage=usage, plugin=PLUGIN,
                          check_fn=check_anthropic_tools)

    if len(sys.argv) < 2:
        print(usage())
        sys.exit(1)
    definition = primary.load_definition(sys.argv[1])

    env_vm_name = os.environ.get("_vm_name") or None
    for vm_name, _ssh_cmd in k8s.addon_nodes(definition, "anthropic_tools", vm_name=env_vm_name):
        cfg = k8s.addon_node_config(definition, "anthropic_tools", vm_name)
        require_ssh(vm_name)
        creds = ac.resolve_credential(cfg, "anthropic", {
            "anthropic_oauth_token": "anthropic_tools_oauth_token",
            "anthropic_api_key": "anthropic_tools_api_key",
        }, account_key="anthropic_tools_anthropic_account")
        setup_anthropic_tools(vm_name, cfg, credential_env(creds))


if __name__ == "__main__":
    main()
