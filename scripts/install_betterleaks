#!/usr/bin/env python3.11
# Part of lab-in-a-box. Installs Betterleaks, the secrets scanner the Gitleaks maintainers now develop, in either
# of two shapes: a podman container on a node, or a Kubernetes CronJob that clones repositories and scans them on
# a schedule. The plumbing both shapes share is libs/secret_scan.py, the same as install_gitleaks uses.
# Author/s: Raul Mahiques
# License: GPLv3
#
# References: https://github.com/betterleaks/betterleaks, "maintained by the folks who made Gitleaks, including
# the original author", MIT. The image is ghcr.io/betterleaks/betterleaks, whose entrypoint is betterleaks itself.
#
# Its command line changed between its two major versions, and this add-on writes whichever one the version in
# betterleaks_version asks for, so a lab definition does not change when it moves between them:
#   1.x  the Gitleaks command line: "dir"/"git", --report-format, --report-path, --baseline-path, --no-banner.
#   2.x  "fs"/"git", and the report is --output, whose extension chooses the format. --report-format,
#        --report-path and --baseline-path were removed upstream, and a configuration file is no longer discovered
#        automatically, so betterleaks_config matters more there than it does for Gitleaks.
# betterleaks_command is written in the 1.x words either way ("dir" or "git") and translated, so that one lab
# definition works against both.
#
# Schema version: 1.0
#
# JSON section: "betterleaks" — Betterleaks secret scanning
#   betterleaks_mode     : how it runs. "container" runs it with podman on each node that lists this add-on, over
#                          the directory betterleaks_scan_path names. "kubernetes" installs a CronJob on the
#                          kcluster that clones betterleaks_repos and scans them.
#                          (options: container, kubernetes) (default: container)
#   betterleaks_version  : release version, without the "v". The default is the latest stable release; 2.x is in
#                          release candidates at the time of writing, and naming one here switches the command
#                          line to its own shape. (default: 1.10.1)
#   betterleaks_image    : container image, whose entrypoint is betterleaks itself
#                          (default: ghcr.io/betterleaks/betterleaks)
#   betterleaks_image_tag : image tag. Empty uses "v" and betterleaks_version, which is how the images are tagged.
#
# container fields
#   betterleaks_scan_path : the directory on the node to scan, mounted read-only into the container. Required in
#                          this mode.
#   betterleaks_command  : "dir" scans the files as they are on disk ("fs" on 2.x), "git" scans a repository's
#                          commit history. (options: dir, git) (default: dir)
#   betterleaks_report_path : where the report is written on the node, as JSON
#                          (default: /var/log/betterleaks/betterleaks-report.json)
#   betterleaks_schedule : a five-field cron expression. Set, the scan is written to /etc/cron.d/betterleaks and
#                          repeats; unset, it runs once now. The kubernetes mode's CronJob takes the same
#                          expression, and defaults to "0 3 * * *" there.
#
# kubernetes fields
#   betterleaks_ns       : Kubernetes namespace (default: betterleaks)
#   betterleaks_repos    : list of git URLs the CronJob clones (--depth 1) and scans. Public repositories only:
#                          this add-on configures no credentials, so a private URL fails in the clone step.
#                          Required in this mode. The report is the job's own output, read with
#                          "kubectl -n <namespace> logs job/<name>".
#   betterleaks_git_image : image of the init container that clones them (default: alpine/git)
#
# both modes
#   betterleaks_config   : path on the node of a Betterleaks configuration file, mounted into the container and
#                          passed as --config. On 2.x nothing is discovered automatically, so without this the
#                          embedded default rules are used; a Gitleaks .gitleaks.toml is not accepted there.
#   betterleaks_baseline_path : 1.x only: path of an earlier report whose findings are ignored, passed as
#                          --baseline-path. The flag was removed in 2.x, where a .betterleaksignore file of
#                          fingerprints replaces it, so naming it with a 2.x version is refused rather than
#                          quietly dropped.
#   betterleaks_redact   : "true" or "false" (default: true). Keeps the secrets themselves out of the report and
#                          the log, which in a lab are both world-readable.
#   betterleaks_extra_args : list of further arguments, appended to the command line as given. The escape hatch
#                          for a flag this add-on has no field for, and for anything either major version added
#                          after it was written.
#   betterleaks_fail_on_leaks : "true" or "false" (default: false). False reports findings and lets the lab carry
#                          on, which is what a demo of the tool wants; true makes a scan that found something fail
#                          the add-on, which is what a lab asserting a repository is clean wants.

__version__ = "__LABVERSION__"

PLUGIN = {
    "name": "betterleaks",
    "targets": ["container", "vm", "baremetal"],
    "layers": ["standalone-container", "kubernetes"],
    "requires_kubernetes": None,
    "requires_cluster": [],
    "aux_services": [],
    "check": True,
}

import os
import sys
from pathlib import Path

for _candidate in ("/usr/local/lib/lab_creation", str(Path(__file__).resolve().parent.parent / "libs")):
    if Path(_candidate).is_dir() and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

import addon_common as ac  # noqa: E402
import k8s  # noqa: E402
import primary  # noqa: E402
import secret_scan  # noqa: E402
from lab_creation import die  # noqa: E402

_V2_COMMANDS = {"dir": "fs", "git": "git"}


def major_of(cfg):
    """The major version the lab asked for, as an integer; 1 when it is not a number at all."""
    head = secret_scan.version_of(TOOL, cfg).split(".", 1)[0]
    try:
        return int(head)
    except ValueError:
        return 1


def arguments(cfg, path, config_path="", report_path=""):
    """
    Betterleaks' command line for one scan, in the shape its own major version takes. Every path is one the
    container sees, not one on the node.
    """
    command = str(TOOL.get(cfg, "command", "dir")).strip().lower()
    v2 = major_of(cfg) >= 2
    args = [_V2_COMMANDS.get(command, command) if v2 else command]
    if path:
        args.append(path)
    if not v2:
        args.append("--no-banner")
    if secret_scan.truth(TOOL, cfg, "redact", "true"):
        args.append("--redact")
    if config_path:
        args += ["--config", config_path]
    baseline = TOOL.get(cfg, "baseline_path", "")
    if baseline and not v2:
        args += ["--baseline-path", str(baseline)]
    if report_path:
        args += ["--output", report_path] if v2 else ["--report-format", "json", "--report-path", report_path]
    args += [str(a) for a in secret_scan.list_field(TOOL, cfg, "extra_args")]
    return args


TOOL = secret_scan.Tool(
    name="betterleaks", display="Betterleaks", image="ghcr.io/betterleaks/betterleaks", version="1.10.1",
    arguments=arguments, report="/var/log/betterleaks/betterleaks-report.json")


def _validate(v):
    secret_scan.validate(TOOL, v)
    cfg = v.definition.get("betterleaks", {}) or {}
    extra = cfg.get("betterleaks_extra_args")
    if extra not in ("", None) and not isinstance(extra, (list, str)):
        v.errors.append("[ERROR] betterleaks.betterleaks_extra_args must be a list of strings")
    if cfg.get("betterleaks_baseline_path") and major_of(cfg) >= 2:
        v.errors.append("[ERROR] betterleaks.betterleaks_baseline_path only exists on Betterleaks 1.x: 2.x "
                        "removed --baseline-path, and a .betterleaksignore file of fingerprints replaces it")


def _check(chk):
    secret_scan.check(TOOL, chk)


def main():
    ac.handle_common_args(__file__, __version__, validate_fn=_validate, plugin=PLUGIN, check_fn=_check)

    if len(sys.argv) < 2:
        print("Usage: {} <lab-file>".format(Path(sys.argv[0]).name))
        sys.exit(1)
    definition = primary.load_definition(sys.argv[1])
    defaults = primary.load_defaults()
    cfg = definition.get("betterleaks", {}) or {}
    mode = secret_scan.mode_of(TOOL, cfg)
    if mode not in secret_scan.MODES:
        die("betterleaks.betterleaks_mode='{}': must be one of {}".format(
            cfg.get("betterleaks_mode"), ", ".join(secret_scan.MODES)))

    if mode == "kubernetes":
        target = k8s.first_server_node(definition)
        if not target:
            sys.exit(1)
        vm_name, _ssh_cmd = target
        secret_scan.install_cronjob(TOOL, vm_name, cfg, defaults.get(
            "_templ_addons_loc", "/usr/share/lab_creation/templates/addons/"))
        return

    env_vm_name = os.environ.get("_vm_name") or None
    for vm_name, _ssh_cmd in k8s.addon_nodes(definition, "betterleaks", vm_name=env_vm_name):
        secret_scan.run_container(TOOL, vm_name, k8s.addon_node_config(definition, "betterleaks", vm_name))


if __name__ == "__main__":
    main()
