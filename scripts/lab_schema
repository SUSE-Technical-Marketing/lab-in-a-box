#!/usr/bin/env python3
# lab_schema — parse a lab-in-a-box install script and emit its option schema.
# Part of lab-in-a-box
# Author/s: Raul Mahiques
# License: GPLv3
#
# Usage:
#   lab_schema <script_path> [json|yaml]
#
# Reads the structured comment block starting at "JSON section:" in the given
# script and outputs a machine-readable schema of every configurable option.
# The script's "# Schema version: MAJOR.MINOR" comment line, above that block,
# is the schema's version (schema_version); see schemas/compatibility.json.
# Requires python3; YAML output additionally requires pyyaml (pip install pyyaml).

import json
import re
import sys
from pathlib import Path

for _candidate in ("/usr/local/lib/lab_creation", str(Path(__file__).resolve().parent.parent / "libs")):
    if Path(_candidate).is_dir() and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

# The base lab definition's own schema lives in libs/ so that libs/schema_validate.py can check a lab against it
# without running this script; re-exported here because every consumer reads it off this module.
from lab_schema_base import LAB_SCHEMA_VERSION, base_lab_schema  # noqa: E402,F401

# Infer field type from its name suffix
def _infer_type(name):
    if re.search(r'_ns$|_namespace$', name):        return "namespace"
    if re.search(r'_version$|_ver$', name):          return "version"
    if re.search(r'_repo_url$|_url$', name):         return "url"
    if re.search(r'_port$', name):                   return "port"
    if re.search(r'_pass$|_pwd$|_password$', name):  return "password"
    if re.search(r'_super_privileged$|_enabled$', name): return "boolean"
    if re.search(r'_replicas$|_pg_version$', name):  return "integer"
    return "string"

def parse_script(path):
    """
    Extract the JSON section comment block from a lab-in-a-box install script.
    Returns a dict ready for JSON/YAML serialisation.
    """
    text = Path(path).read_text(errors="replace")
    lines = text.splitlines()

    addon = section = description = ""
    fields = []
    in_block = False
    in_mandatory = False
    current = None      # field currently accumulating continuation lines

    vm = re.search(r'^# Schema version:\s*(\S+)', text, re.M)
    version = vm.group(1) if vm else ""

    for line in lines:
        # ── Find section header ─────────────────────────────────────────────
        if not in_block:
            if "JSON section:" in line:
                m = re.search(r'["“]([^"”]+)["”]', line)
                if m:
                    section = addon = m.group(1)
                # Description: everything after the closing quote + optional decorators
                desc_part = re.sub(r'^.*["”]\s*[─—–\-]*\s*', '', line)
                desc_part = re.sub(r'^#\s*', '', desc_part)
                desc_part = re.sub(r'\s*[─]+\s*$', '', desc_part).strip()
                description = desc_part
                in_block = True
            continue

        # ── Stop at first non-comment line ──────────────────────────────────
        if line and not line.startswith("#"):
            break

        # ── Track MANDATORY / OPTIONAL / EXPERIMENTAL block headers ─────────
        stripped = line.lstrip("#").strip()
        if re.match(r'MANDATORY\b', stripped):
            in_mandatory = True
            current = None
            continue
        if re.match(r'(OPTIONAL|EXPERIMENTAL)\b', stripped):
            in_mandatory = False
            current = None
            continue

        # ── Parse field lines: "#   field_name  : … (default: val)" ────────
        m = re.match(r'^#   ([A-Za-z_][A-Za-z0-9_-]*)\s*:(.*)', line)
        if m:
            current = {
                "name":         m.group(1),
                "_in_mandatory": in_mandatory,
                "_rest":        m.group(2).strip(),
            }
            fields.append(current)
            continue

        # ── Blank comment line ends the current field's accumulation ────────
        if stripped == "":
            current = None
            continue

        # ── Continuation line: append to the current field's raw text ───────
        # (free-standing prose outside any field — e.g. NOTE blocks — is ignored)
        if current is not None:
            current["_rest"] = f'{current["_rest"]} {stripped}'.strip()

    # ── Finalise: split each field's joined raw text into required/default/desc
    for f in fields:
        rest = re.sub(r'\s+', ' ', f.pop("_rest")).strip()
        required = f.pop("_in_mandatory") or bool(re.search(r'\[MANDATORY\]', rest))
        rest = re.sub(r'\[(OPTIONAL|MANDATORY)\]\s*', '', rest)

        default = ""
        dm = re.search(r'\(default:\s*([^)]+)\)', rest)
        if dm:
            default = dm.group(1).strip()
            if len(default) > 1 and default[0] == default[-1] and default[0] in "\"'":
                default = default[1:-1]
            rest = re.sub(r'\s*\(default:[^)]+\)', '', rest)

        # Optional explicit "(options: a, b, c)" annotation — a fixed set of
        # valid values for this field, driving a dropdown in the web UI
        # instead of free text. Not inferred from free-form description
        # prose (too easy to false-positive on unrelated quoted examples);
        # an addon author opts in by adding this annotation explicitly.
        enum = None
        om = re.search(r'\(options:\s*([^)]+)\)', rest)
        if om:
            enum = [v.strip() for v in om.group(1).split(",") if v.strip()]
            rest = re.sub(r'\s*\(options:[^)]+\)', '', rest)

        # Optional explicit "(pattern: regex)" annotation for format
        # validation in the web UI (e.g. an IP/MAC shape). Same opt-in
        # rationale as "(options: ...)" above. NOTE: the capture is
        # `[^)]+` — a pattern containing a literal ")" isn't supported by
        # this simple annotation syntax.
        pattern = None
        pm = re.search(r'\(pattern:\s*([^)]+)\)', rest)
        if pm:
            pattern = pm.group(1).strip()
            rest = re.sub(r'\s*\(pattern:[^)]+\)', '', rest)

        # Optional explicit "(min: N)" / "(max: N)" annotations for numeric
        # range validation in the web UI.
        min_val = max_val = None
        mnm = re.search(r'\(min:\s*(-?\d+)\)', rest)
        if mnm:
            min_val = int(mnm.group(1))
            rest = re.sub(r'\s*\(min:-?\d+\)', '', rest)
        mxm = re.search(r'\(max:\s*(-?\d+)\)', rest)
        if mxm:
            max_val = int(mxm.group(1))
            rest = re.sub(r'\s*\(max:-?\d+\)', '', rest)

        f["required"]    = required
        f["default"]     = default
        f["type"]        = _infer_type(f["name"])
        f["description"] = rest.strip()
        if enum:
            f["enum"] = enum
        if pattern:
            f["pattern"] = pattern
        if min_val is not None:
            f["min"] = min_val
        if max_val is not None:
            f["max"] = max_val

    return {
        "schema_version": version,
        "addon":          addon,
        "section":        section,
        "description":    description,
        "fields":         fields,
    }


def _emit(schema, fmt):
    if fmt == "json":
        print(json.dumps(schema, indent=2, ensure_ascii=False))
    else:
        try:
            import yaml
        except ImportError:
            print("ERROR: pyyaml is required for YAML output (pip install pyyaml)", file=sys.stderr)
            sys.exit(1)
        print(yaml.dump(schema, default_flow_style=False, allow_unicode=True, sort_keys=False))


_HELP_TEXT = """\
Usage: lab_schema <script_path> [json|yaml]
       lab_schema --base [json|yaml]

Prints the option schema of a lab-in-a-box install script, read from its "JSON section:" comment block, in JSON
(default) or YAML. YAML output requires pyyaml.

Options:
  --base      Print the base lab-definition schema (common, nodes, kclusters) instead.
  --help, -h  Print this help and exit.
"""


def main():
    if "--help" in sys.argv[1:] or "-h" in sys.argv[1:]:
        print(_HELP_TEXT, end="")
        sys.exit(0)
    if len(sys.argv) < 2:
        print(f"Usage: {Path(sys.argv[0]).name} <script_path>|--base [json|yaml]", file=sys.stderr)
        sys.exit(1)

    # --base emits the base lab-definition schema (common/nodes/kclusters)
    if sys.argv[1] == "--base":
        fmt = sys.argv[2] if len(sys.argv) > 2 else "json"
        if fmt not in ("json", "yaml"):
            print(f"ERROR: format must be 'json' or 'yaml', got '{fmt}'", file=sys.stderr)
            sys.exit(1)
        _emit(base_lab_schema(), fmt)
        return

    script_path = sys.argv[1]
    fmt         = sys.argv[2] if len(sys.argv) > 2 else "json"

    if fmt not in ("json", "yaml"):
        print(f"ERROR: format must be 'json' or 'yaml', got '{fmt}'", file=sys.stderr)
        sys.exit(1)

    if not Path(script_path).is_file():
        print(f"ERROR: file not found: {script_path}", file=sys.stderr)
        sys.exit(1)

    _emit(parse_script(script_path), fmt)


if __name__ == "__main__":
    main()
