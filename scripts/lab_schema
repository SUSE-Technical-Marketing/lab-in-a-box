                    {"name": "pxe_boot_filename", "required": False, "type": "string", "default": "lpxelinux.0", "description": "PXE boot filename handed out to clients (override for UEFI/iPXE chainloading)"},
                ],
            },
        },
    }


def _emit(schema, fmt):
    if fmt == "json":
        print(json.dumps(schema, indent=2, ensure_ascii=False))
    else:
        try:
            import yaml
        except ImportError:
            print("ERROR: pyyaml is required for YAML output (pip install pyyaml)", file=sys.stderr)
            sys.exit(1)
        print(yaml.dump(schema, default_flow_style=False, allow_unicode=True, sort_keys=False))


def main():
    if len(sys.argv) < 2:
        print(f"Usage: {Path(sys.argv[0]).name} <script_path>|--base [json|yaml]", file=sys.stderr)
        sys.exit(1)

    # --base emits the base lab-definition schema (common/nodes/kclusters)
    if sys.argv[1] == "--base":
        fmt = sys.argv[2] if len(sys.argv) > 2 else "json"
        if fmt not in ("json", "yaml"):
            print(f"ERROR: format must be 'json' or 'yaml', got '{fmt}'", file=sys.stderr)
            sys.exit(1)
        _emit(base_lab_schema(), fmt)
        return

    script_path = sys.argv[1]
    fmt         = sys.argv[2] if len(sys.argv) > 2 else "json"

    if fmt not in ("json", "yaml"):
        print(f"ERROR: format must be 'json' or 'yaml', got '{fmt}'", file=sys.stderr)
        sys.exit(1)

    if not Path(script_path).is_file():
        print(f"ERROR: file not found: {script_path}", file=sys.stderr)
        sys.exit(1)

    _emit(parse_script(script_path), fmt)


if __name__ == "__main__":
    main()
