    setup_helm, helm_repo_add, ssh_run, ssh_output, add_service_dns, add_dns_to_named_rr,
    restart_named, die, warn,
)


def _validate(v):
    v.vns("rancher")
    v.vver("rancher")
    v.vurl("rancher")
    cfg = v.definition.get("rancher", {}) or {}
    kclusters = v.definition.get("kclusters", {}) or {}
    for entry in cfg.get("rancher_import_clusters") or []:
        if not isinstance(entry, dict):
            v.errors.append("[ERROR] rancher.rancher_import_clusters: every entry is an object with a 'kcluster' "
                            "of this lab or a 'node' to reach the cluster through")
            continue
        kcluster = str(entry.get("kcluster") or "").strip()
        node = str(entry.get("node") or "").strip()
        name = str(entry.get("name") or kcluster).strip()
        if not kcluster and not node:
            v.errors.append("[ERROR] rancher.rancher_import_clusters[{}]: needs a 'kcluster' of this lab or a "
                            "'node' to reach the cluster through".format(name or "?"))
        if kcluster and kcluster not in kclusters:
            v.errors.append("[ERROR] rancher.rancher_import_clusters[{}]: kcluster '{}' is not in this lab".format(
                name or kcluster, kcluster))
        if node and node not in (v.definition.get("nodes") or {}) and "." not in node:
            v.errors.append("[ERROR] rancher.rancher_import_clusters[{}]: node '{}' is neither a node of this lab "
                            "nor a hostname".format(name or node, node))
        if not name:
            v.errors.append("[ERROR] rancher.rancher_import_clusters: an entry reached by 'node' needs a 'name' "
                            "for the cluster in Rancher")
        elif not IMPORT_NAME_RE.match(name):
            v.errors.append("[ERROR] rancher.rancher_import_clusters[{}]: the name Rancher gives a cluster must be "
                            "a Kubernetes name (lower-case letters, digits and dashes)".format(name))


def setup_rancher_repo(hostname, cfg):
    """Add the Rancher and cert-manager Helm repos (Rancher Prime unless rancher_rel/rancher_repo_url are set)."""
    helm_repo_add(hostname, cfg.get("rancher_rel") or "rancher-prime",
                  cfg.get("rancher_repo_url") or "https://charts.rancher.com/server-charts/prime")
    helm_repo_add(hostname, cfg.get("rancher_cert_repo_name") or "jetstack",
                  cfg.get("rancher_cert_repo_url") or "https://charts.jetstack.io")


def setup_cert_manager(hostname, cfg, ingress_classname=None):
    """Install cert-manager and two staging/prod ClusterIssuers. Mirrors setup_cert-manager (bash)."""
    print("# Setup Cert-manager")
    cert_manager_ver = versions.helm_version_flag(cfg.get("cert_manager_ver"))

    result = ssh_run(hostname,
                      "helm upgrade -i cert-manager jetstack/cert-manager {} --namespace cert-manager "
                      "--create-namespace --set installCRDs=true".format(cert_manager_ver), check=False)
    if result.returncode != 0:
        die("cert-manager helm install failed on '{}'".format(hostname))

    ssh_run(hostname,
            "kubectl wait pods -n cert-manager -l app.kubernetes.io/instance=cert-manager "
            "--for condition=Ready --timeout=120s 2>/dev/null", check=False)

    ingress_class = ingress_classname or "traefik"
    manifest = """\
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-ci
spec:
  acme:
    server: https://acme-staging-v02.api.letsencrypt.org/directory
    email: none@someunknowndomain.com
    privateKeySecretRef:
      name: letsencrypt-staging
    solvers:
      - http01:
          ingress:
            class: {ingress_class}
...
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: none@someunknowndomain.com
    privateKeySecretRef:
      name: letsencrypt-prod
    solvers:
      - http01:
          ingress:
            class: {ingress_class}
""".format(ingress_class=ingress_class)
    ssh_run(hostname, "kubectl apply -f -", input_text=manifest)


def setup_rancher(hostname, definition, clu_name, mydomain, clu_type, cfg, remote_dns_servers=None):
    """
    Install Rancher via Helm, register its DNS entry (both via add_service_dns
    and explicitly for every matching server node), and retrieve the
    bootstrap password. Mirrors setup_rancher (bash).

    rancher_helm_chart defaults to rancher-prime/rancher. An unset rancher_initial_pwd lets Rancher generate the
    bootstrap password, which is read back and printed. rancher_version and cert_manager_ver take a bare chart
    version or "--version X" (versions.helm_version_flag()).
    """
    print("# Setup Rancher {} in cluster \"{}\"".format(cfg.get("rancher_helm_rel") or "rancher", clu_name))

    helm_rel = cfg.get("rancher_helm_rel") or "rancher"
    helm_chart = cfg.get("rancher_helm_chart") or "rancher-prime/rancher"
    shorthn = cfg.get("rancher_shorthn") or "rancher"
    hostname_fqdn = "{}.{}.{}".format(shorthn, clu_name, mydomain)
    rancher_version = versions.helm_version_flag(cfg.get("rancher_version"))
    initial_pwd = cfg.get("rancher_initial_pwd") or ""
    pwd_arg = "--set bootstrapPassword={}".format(shlex.quote(initial_pwd)) if initial_pwd else ""
    replicas = cfg.get("rancher_replicas") or "2"

    result = ssh_run(hostname,
                      "helm upgrade -i {} {} --create-namespace --namespace cattle-system "
                      "--set hostname={} {} {} --set replicas={} ".format(
                          shlex.quote(helm_rel), shlex.quote(helm_chart), shlex.quote(hostname_fqdn),
                          rancher_version, pwd_arg, shlex.quote(replicas)),
                      check=False)
    if result.returncode != 0:
        sys.exit(1)

    print("## Add Rancher DNS")
    dns_entry = "{}.{}".format(shorthn, clu_name)
    add_service_dns(definition, clu_name, clu_type, dns_entry, mydomain, remote_dns_servers=remote_dns_servers)

    install_key = "INSTALL_{}_TYPE".format(clu_type.upper())
    matching_nodes = [
        name for name, node_cfg in definition.get("nodes", {}).items()
        if node_cfg.get(install_key) == "server" and node_cfg.get("kcluster") == clu_name
    ]
    for node_name in matching_nodes:
        add_dns_to_named_rr(definition, dns_entry, node_name, mydomain, remote_dns_servers=remote_dns_servers)

    restart_named(remote_dns_servers)

    print("Wait for rancher to be ready")
    ssh_run(hostname, "kubectl wait pods -n cattle-system -l app=rancher --for condition=Ready --timeout=300s",
            check=False)
    time.sleep(60)

    initial_rancher_pwd = ssh_output(
        hostname,
        "kubectl get secret --namespace cattle-system bootstrap-secret "
        "-o jsonpath='{.data.bootstrapPassword}' | base64 -d")
    if not initial_rancher_pwd:
        die("Failed to retrieve bootstrap secret")

    admin_pwd = finish_bootstrap(hostname, hostname_fqdn, initial_rancher_pwd,
                                 cfg.get("rancher_admin_pwd") or initial_rancher_pwd)
    print("# Admin password: {}".format(admin_pwd))

    import_clusters(hostname, definition, hostname_fqdn, admin_pwd, cfg)


def finish_bootstrap(hostname, hostname_fqdn, bootstrap_pwd, admin_pwd):
    """
    Complete Rancher's first login and set its server URL, on `hostname`, for the Rancher served at
    `hostname_fqdn`. Returns the password the admin user ends up with.

    Until someone logs in once, Rancher leaves settings/server-url empty and never finishes bootstrapping, and
    without that URL no ClusterRegistrationToken is ever given a manifest URL, so no cluster can be imported and
    the lab's Rancher is only usable by hand. Confirmed live on 2026-10-17 while importing a kubeadm cluster: with
    server-url empty, the token stays empty forever.

    Idempotent: a Rancher that is already bootstrapped refuses the bootstrap password, which is not an error here,
    and the server URL is set to the value it should already have.
    """
    print("# Finishing Rancher's bootstrap (first login and server URL)")
    login = ("curl -sk https://{host}/v3-public/localProviders/local?action=login "
             "-H 'content-type: application/json' "
             "-d {payload} | tr ',' '\n' | sed -n 's/.*\"token\":\"\\([^\"]*\\).*/\\1/p' | head -1")
    token = ssh_output(hostname, login.format(
        host=hostname_fqdn,
        payload=shlex.quote(json.dumps({"username": "admin", "password": bootstrap_pwd}))))
    if not token:
        # Already bootstrapped: the generated password no longer works. Nothing to finish.
        token = ssh_output(hostname, login.format(
            host=hostname_fqdn,
            payload=shlex.quote(json.dumps({"username": "admin", "password": admin_pwd}))))
        if not token:
            warn("- Could not log in to Rancher at https://{} to finish its bootstrap; a cluster cannot be "
                 "imported until someone logs in once".format(hostname_fqdn))
            return admin_pwd
        print("# Rancher was already bootstrapped")
    elif admin_pwd != bootstrap_pwd:
        ssh_run(hostname, "curl -sk -o /dev/null https://{host}/v3/users?action=changepassword "
                          "-H 'content-type: application/json' -H {auth} -d {payload}".format(
                              host=hostname_fqdn, auth=shlex.quote("Authorization: Bearer " + token),
                              payload=shlex.quote(json.dumps({"currentPassword": bootstrap_pwd,
                                                              "newPassword": admin_pwd}))), check=False)

    # The URL every downstream cluster's agent is told to come back to.
    ssh_run(hostname, "curl -sk -o /dev/null -X PUT https://{host}/v3/settings/server-url "
                      "-H 'content-type: application/json' -H {auth} -d {payload}".format(
                          host=hostname_fqdn, auth=shlex.quote("Authorization: Bearer " + token),
                          payload=shlex.quote(json.dumps({"name": "server-url",
                                                          "value": "https://" + hostname_fqdn}))), check=False)
    found = ssh_output(hostname, "kubectl get settings.management.cattle.io server-url -o jsonpath='{.value}'")
    if found != "https://" + hostname_fqdn:
        warn("- Rancher's server-url is '{}', not 'https://{}'; importing a cluster will not work until it "
             "is".format(found or "empty", hostname_fqdn))
    else:
        print("# Rancher's server URL is https://{}".format(hostname_fqdn))
    return admin_pwd


IMPORT_NAME_RE = re.compile(r"^[a-z0-9]([-a-z0-9]*[a-z0-9])?$")
IMPORT_WORKSPACE = "fleet-default"
IMPORT_ID_TIMEOUT = 120
IMPORT_MANIFEST_TIMEOUT = 180
IMPORT_ACTIVE_TIMEOUT = 1800
IMPORT_POLL = 10


def _api_token(hostname, hostname_fqdn, admin_pwd):
    """A Rancher API bearer token for the admin user, or "" when the login fails."""
    return ssh_output(hostname, (
        "curl -sk https://{host}/v3-public/localProviders/local?action=login "
        "-H 'content-type: application/json' -d {payload} "
        "| tr ',' '\n' | sed -n 's/.*\"token\":\"\\([^\"]*\\).*/\\1/p' | head -1"
    ).format(host=hostname_fqdn, payload=shlex.quote(json.dumps({"username": "admin", "password": admin_pwd}))))


def _poll(what, read, timeout):
    """Call `read` until it returns something, for at most `timeout` seconds; "" when it never does."""
    waited = 0
    while waited < timeout:
        value = read()
        if value:
            return value
        time.sleep(IMPORT_POLL)
        waited += IMPORT_POLL
        if waited % 60 == 0:
            print("  still waiting for {} ({}s)".format(what, waited))
    return ""


def import_cluster(hostname, hostname_fqdn, admin_pwd, name, target_node, insecure_tls=True):
    """
    Import the Kubernetes cluster that `target_node`'s kubectl talks to into the Rancher on `hostname`, as `name`.
    Returns Rancher's own cluster id, or "" when it could not be imported.

    The sequence, and why each step is what it is (confirmed live on 2026-10-17 importing a kubeadm cluster):

      1. A provisioning.cattle.io/v1 Cluster, which is how a cluster Rancher does not provision is registered. Its
         agentEnvVars carry CATTLE_INSECURE_TLS, because a lab's Rancher serves a self-signed certificate and the
         agent in the other cluster has no reason to trust it.
      2. Its .status.clusterName, Rancher's own c-m-xxxxx id, which the rest needs and which appears a moment later.
      3. A ClusterRegistrationToken created THROUGH THE v3 API. One applied as a CRD is never populated: no token,
         no manifest URL, forever. This step is why the import needs an API login at all.
      4. The manifest that token points at, applied on the other cluster. It installs the cattle-cluster-agent.
      5. Rancher reporting the cluster active, which is the only evidence the agent reached back.

    Importing needs Rancher's server URL to be set (finish_bootstrap does it): without it step 3 yields nothing.
    """
    kubectl_rancher = "kubectl"
    existing = ssh_run(hostname, "{} -n {} get cluster.provisioning.cattle.io {} -o jsonpath='{{.status.clusterName}}'"
                       .format(kubectl_rancher, shlex.quote(IMPORT_WORKSPACE), shlex.quote(name)),
                       check=False, capture=True)
    if existing.returncode == 0 and (existing.stdout or "").strip():
        cluster_id = (existing.stdout or "").strip()
        print("# Cluster '{}' is already imported as {}".format(name, cluster_id))
    else:
        print("# Importing cluster '{}' into Rancher".format(name))
        manifest = {
            "apiVersion": "provisioning.cattle.io/v1",
            "kind": "Cluster",
            "metadata": {"name": name, "namespace": IMPORT_WORKSPACE},
            "spec": {},
        }
        if insecure_tls:
            manifest["spec"]["agentEnvVars"] = [{"name": "CATTLE_INSECURE_TLS", "value": "true"}]
        ssh_run(hostname, "{} apply -f -".format(kubectl_rancher), input_text=json.dumps(manifest))
        cluster_id = _poll("Rancher to give '{}' an id".format(name), lambda: ssh_output(
            hostname, "{} -n {} get cluster.provisioning.cattle.io {} -o jsonpath='{{.status.clusterName}}'".format(
                kubectl_rancher, shlex.quote(IMPORT_WORKSPACE), shlex.quote(name))), IMPORT_ID_TIMEOUT)
        if not cluster_id:
            warn("- Rancher never gave cluster '{}' an id; it is not imported".format(name))
            return ""

    token = _api_token(hostname, hostname_fqdn, admin_pwd)
    if not token:
        warn("- Could not log in to Rancher to create a registration token for '{}'; it is not imported".format(name))
        return ""

    # The registration token has to come from the API. The same call on an already-imported cluster just returns
    # another valid token, so a re-run is safe.
    ssh_run(hostname, "curl -sk -o /dev/null -X POST https://{host}/v3/clusterregistrationtoken "
                      "-H 'content-type: application/json' -H {auth} -d {payload}".format(
                          host=hostname_fqdn, auth=shlex.quote("Authorization: Bearer " + token),
                          payload=shlex.quote(json.dumps({"type": "clusterRegistrationToken",
                                                          "clusterId": cluster_id}))), check=False)
    # Only a real import manifest: the collection's own answer also carries a "manifestUrl" in its sort links
    # (…?clusterId=…&sort=manifestUrl), and applying that gives kubectl nothing to apply.
    manifest_url = _poll("the registration manifest of '{}'".format(name), lambda: ssh_output(
        hostname, "curl -sk -H {auth} 'https://{host}/v3/clusterregistrationtokens?clusterId={cid}' "
                  "| tr ',' '\n' "
                  "| sed -n 's|.*\"manifestUrl\":\"\\(https[^\"]*/v3/import/[^\"]*\\.yaml\\)\".*|\\1|p' "
                  "| head -1".format(
                      auth=shlex.quote("Authorization: Bearer " + token), host=hostname_fqdn,
                      cid=cluster_id)), IMPORT_MANIFEST_TIMEOUT)
    if not manifest_url:
        warn("- Rancher never published a registration manifest for '{}'. Its server URL has to be set first "
             "(settings/server-url); '{}' is not imported".format(name, name))
        return ""

    print("# Registering '{}' from {}".format(name, target_node))
    applied = ssh_run(target_node, "curl -sfk {} | kubectl apply -f -".format(shlex.quote(manifest_url)),
                      check=False, capture=True)
    if applied.returncode != 0:
        warn("- The registration manifest could not be applied on '{}': {}".format(
            target_node, (getattr(applied, "stderr", "") or applied.stdout or "").strip()[:200]))
        return ""

    state = _poll("'{}' to go active in Rancher".format(name), lambda: (ssh_output(
        hostname, "{} -n {} get cluster.provisioning.cattle.io {} -o jsonpath='{{.status.ready}}'".format(
            kubectl_rancher, shlex.quote(IMPORT_WORKSPACE), shlex.quote(name))) == "true") and "ready" or "",
        IMPORT_ACTIVE_TIMEOUT)
    if not state:
        warn("- '{}' was registered as {} but Rancher has not reported it ready yet; it may still be "
             "starting its agent".format(name, cluster_id))
        return cluster_id
    print("# Cluster '{}' is imported and active in Rancher as {}".format(name, cluster_id))
    return cluster_id


def import_clusters(hostname, definition, hostname_fqdn, admin_pwd, cfg):
    """
    Import every cluster the lab's rancher_import_clusters asks for. Returns {name: cluster id} for those that were
    imported. An entry naming a kcluster of this lab is reached through that kcluster's own node (k8s.kcluster_node);
    one naming a node is reached through that node.
    """
    entries = cfg.get("rancher_import_clusters") or []
    if not entries:
        return {}
    imported = {}
    for entry in entries:
        kcluster = str(entry.get("kcluster") or "").strip()
        name = str(entry.get("name") or kcluster).strip()
        target = str(entry.get("node") or "").strip() or (k8s.kcluster_node(definition, kcluster) if kcluster else "")
        if not name or not target:
            warn("- rancher_import_clusters: an entry needs a 'kcluster' of this lab or a 'node' to reach the "
                 "cluster through, and a name; skipping {!r}".format(entry))
            continue
        cluster_id = import_cluster(hostname, hostname_fqdn, admin_pwd, name, target,
                                    insecure_tls=str(entry.get("insecure_tls", "true")).lower() != "false")
        if cluster_id:
            imported[name] = cluster_id
    return imported

def _check(chk):
    """
    What is deployed against the lab's "rancher" section: the Helm release in cattle-system, its chart version
    against rancher_version, the hostname it was installed with against rancher_shorthn and the cluster's domain,
    the replica count, and that every Rancher pod is ready.
    """
    if "rancher" not in chk.definition:
        chk.ok("this lab has no rancher section, so there is nothing to check")
        return
    cfg = chk.definition.get("rancher", {}) or {}
    hostname = chk.vm_name

    release = ssh_run(hostname, "helm -n cattle-system list -o json", check=False, capture=True)
    try:
        entries = [e for e in json.loads((release.stdout or "").strip() or "[]") if e.get("name") == "rancher"]
    except ValueError:
        entries = []
    if not entries:
        chk.fail("there is no 'rancher' Helm release in cattle-system")
        return
    chart = str(entries[0].get("chart", ""))
    chk.ok("the 'rancher' Helm release is deployed in cattle-system ({})".format(chart or "?"))

    wanted = str(cfg.get("rancher_version") or "")
    if wanted:
        chk.expect("the chart version", wanted.lstrip("v"), chart.rsplit("-", 1)[-1])

    clu_cfg = k8s.load_kclu_vars(chk.definition, chk.clu_name) if chk.clu_name else {}
    mydomain = clu_cfg.get("mydomain") or (chk.definition.get("common", {}) or {}).get("mydomain", "")
    if chk.clu_name and mydomain:
        expected_host = "{}.{}.{}".format(cfg.get("rancher_shorthn") or "rancher", chk.clu_name, mydomain)
        found = ssh_run(hostname, "helm -n cattle-system get values rancher -o json", check=False, capture=True)
        try:
            values = json.loads((found.stdout or "").strip() or "{}")
        except ValueError:
            values = {}
        chk.expect("the hostname Rancher serves", expected_host, str(values.get("hostname", "")))
        chk.expect("the replica count", str(cfg.get("rancher_replicas") or "2"), str(values.get("replicas", "")))

    for entry in cfg.get("rancher_import_clusters") or []:
        name = str((entry or {}).get("name") or (entry or {}).get("kcluster") or "").strip()
        if not name:
            continue
        state = ssh_run(hostname, "kubectl -n {} get cluster.provisioning.cattle.io {} "
                                  "-o jsonpath='{{.status.ready}}'".format(
                                      shlex.quote(IMPORT_WORKSPACE), shlex.quote(name)),
                        check=False, capture=True)
        if state.returncode != 0:
            chk.fail("cluster '{}' is not imported into this Rancher".format(name))
        elif (state.stdout or "").strip() != "true":
            chk.fail("cluster '{}' is imported but Rancher does not report it ready".format(name))
        else:
            chk.ok("cluster '{}' is imported and ready in Rancher".format(name))

    ready = ssh_run(hostname, "kubectl -n cattle-system get deploy rancher "
                              "-o jsonpath='{.status.readyReplicas}/{.spec.replicas}'",
                    check=False, capture=True)
    state = (ready.stdout or "").strip()
    if not state or state.startswith(("0/", "/")):
        chk.fail("the rancher deployment in cattle-system has no ready replica (it reports '{}')".format(
            state or "nothing"))
    else:
        want, _, have = state.partition("/")
        if want != have:
            chk.fail("the rancher deployment has {} of {} replicas ready".format(want, have))
        else:
            chk.ok("the rancher deployment in cattle-system has {} replica(s) ready".format(want))


def main():
    ac.handle_common_args(__file__, __version__, validate_fn=_validate, plugin=PLUGIN, check_fn=_check)

    if len(sys.argv) < 2:
        print("Usage: {} <lab.json>".format(Path(sys.argv[0]).name))
        sys.exit(1)
    json_file = sys.argv[1]
    definition = primary.load_definition(json_file)
    config = primary.load_config()

    # NOTE: same pattern as install_harvester — bash never scans for a node
    # here, it relies entirely on _vm_name/clu_name inherited from the
    # environment (set by setup_lab.py's cluster-addon invocation).
    vm_name = os.environ.get("_vm_name", "")
    clu_name = os.environ.get("clu_name", "")
    node_cfg = definition.get("nodes", {}).get(vm_name, {})

    # Support both KUBERNETES_NODE_TYPE (new) and INSTALL_RKE2_TYPE (deprecated)
    node_type = node_cfg.get("KUBERNETES_NODE_TYPE") or node_cfg.get("INSTALL_RKE2_TYPE", "")
    if node_type in ("server", ""):
        print("Using node: \"{}\"".format(vm_name))
        clu_cfg = k8s.load_kclu_vars(definition, clu_name) if clu_name else {}
        cfg = definition.get("rancher", {}) or {}
        online = definition.get("common", {}).get("online") == "1"
        remote_dns_servers = config.get("REMOTE_DNS_SERVERS", "").split() or None

        setup_helm(vm_name, clu_name, online=online)
        print("Setup_rancher_repo")
        setup_rancher_repo(vm_name, cfg)
        setup_cert_manager(vm_name, cfg, ingress_classname=definition.get("common", {}).get("ingressClassname"))
        setup_rancher(vm_name, definition, clu_name, clu_cfg.get("mydomain", ""), clu_cfg.get("clu_type", ""),
                      cfg, remote_dns_servers=remote_dns_servers)


if __name__ == "__main__":
    main()
