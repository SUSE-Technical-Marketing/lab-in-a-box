#!/usr/bin/env python3.11
# Part of lab-in-a-box, it will install Milvus (vector database, for RAG/embedding-search demos)
# Author/s: Raul Mahiques
# License: GPLv3
#
# Schema version: 2.0
#
# JSON section: "milvus" — Milvus vector database (RAG/embedding search)
#   milvus_version    : [OPTIONAL] Helm chart version (empty = latest)
#   milvus_ns         : [OPTIONAL] namespace (default: milvus)
#   milvus_source : [OPTIONAL] where the chart comes from:
#                         "appcollection" (the default), or "upstream" for the project's own chart, no account
#                         needed), or "appcollection" for milvus from
#                         oci://dp.apps.rancher.io/charts/milvus.
#                         "appcollection" needs an Application Collection user and token:
#                         milvus_appcollection_user/milvus_appcollection_password, or
#                         milvus_appcollection_account naming a credential file of kind
#                         "appcollection" (one such file in the store is found on its own).
#   milvus_appcollection_user     : [OPTIONAL] Application Collection user
#   milvus_appcollection_password : [OPTIONAL] Application Collection access token
#   milvus_appcollection_account  : [OPTIONAL] name of an "appcollection" credential file
#   milvus_shorthn    : [OPTIONAL] hostname prefix (default: milvus)
#   milvus_rel        : [OPTIONAL] Helm repo alias (default: milvus)
#   milvus_repo_url   : [OPTIONAL] Helm repo URL (default: https://zilliztech.github.io/milvus-helm)
#   milvus_cluster    : [OPTIONAL] "true"/"false" (default: false) — false installs Milvus STANDALONE
#                       (etcd+minio embedded, single pod, the right default for a lab); "true" installs
#                       the full multi-component cluster topology, needs real resources to be worth it
#
# This is the community/upstream Milvus chart (zilliztech/milvus-helm) — SUSE's own re-packaged build
# used by the "suse_ai" addon is a SEPARATE chart (oci://dp.apps.rancher.io/charts/milvus); don't run
# both against the same cluster/namespace.
#
# Chart and standalone-mode --set flags follow zilliztech/milvus-helm's README and values.yaml.
# The milvus-io.github.io/milvus-helm repo is archived and is not used.

__version__ = "__LABVERSION__"

APPCOLLECTION_CHART = "milvus"

PLUGIN = {
    "name": "milvus",
    "targets": ["container"],
    "layers": ["kubernetes"],
    "requires_kubernetes": ["rke2", "k3s"],
    "aux_services": [],
}

import shlex
import sys
from pathlib import Path

for _candidate in ("/usr/local/lib/lab_creation", str(Path(__file__).resolve().parent.parent / "libs")):
    if Path(_candidate).is_dir() and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

import addon_common as ac  # noqa: E402
import primary  # noqa: E402
import k8s  # noqa: E402
from lab_creation import setup_helm, helm_repo_add, ssh_run, die  # noqa: E402
import appco_common as appco  # noqa: E402


def _validate(v):
    cfg = v.definition.get("milvus", {}) or {}
    source = str(cfg.get("milvus_source") or appco.SOURCE_APPCOLLECTION).strip().lower()
    if source not in appco.SOURCES:
        v.errors.append("[ERROR] milvus.milvus_source '{}' is invalid — use one of: {}".format(
            source, ", ".join(appco.SOURCES)))
    elif source == appco.SOURCE_APPCOLLECTION:
        v.vreq_or_credential("milvus", "milvus_appcollection_user", "appcollection",
                             account_field="milvus_appcollection_account")
        v.vreq_or_credential("milvus", "milvus_appcollection_password", "appcollection",
                             account_field="milvus_appcollection_account")
    v.vns("milvus")
    v.vver("milvus")
    v.vbool("milvus", "milvus_cluster")


def setup_milvus_repo(hostname, milvus_rel=None, milvus_repo_url=None):
    """Add the Milvus Helm repo."""
    helm_repo_add(hostname, milvus_rel or "milvus", milvus_repo_url or "https://zilliztech.github.io/milvus-helm")


def setup_milvus(hostname, milvus_rel=None, milvus_ns=None, milvus_version=None, milvus_cluster=None,
                 extra_set="", from_appcollection=False):
    """Install Milvus, standalone by default (single pod — the right lab-sized default)."""
    rel = milvus_rel or "milvus"
    ns = milvus_ns or "milvus"
    ver_arg = "--version {}".format(shlex.quote(milvus_version)) if milvus_version else ""
    cluster_enabled = "true" if str(milvus_cluster) == "true" else "false"

    # Standalone mode is configured differently by the two charts. zilliztech/milvus-helm puts MinIO in standalone
    # mode and turns Pulsar off; the SUSE Application Collection's chart has neither key, because its standalone
    # deployment carries its own message queue (standalone.messageQueue, woodpecker), so there the single-replica
    # subcharts and Kafka are what to set.
    standalone_args = ""
    if cluster_enabled == "false":
        if from_appcollection:
            standalone_args = (
                " --set etcd.replicaCount=1"
                " --set minio.replicas=1"
                " --set kafka.enabled=false"
            )
        else:
            standalone_args = (
                " --set etcd.replicaCount=1"
                " --set minio.mode=standalone"
                " --set pulsarv3.enabled=false"
            )

    ssh_run(hostname,
            "helm upgrade -i milvus {}/milvus --namespace {} --create-namespace "
            "--set cluster.enabled={}{} "
            "{}{}".format(rel, ns, cluster_enabled, standalone_args, ver_arg, extra_set))

    print("Milvus installed ({}). Namespace: {}".format("cluster" if cluster_enabled == "true" else "standalone", ns))
    print("In-cluster endpoint: milvus.{}.svc.cluster.local:19530".format(ns))


def main():
    ac.handle_common_args(__file__, __version__, validate_fn=_validate, plugin=PLUGIN)

    if len(sys.argv) < 2:
        print("Usage: {} <lab.json>".format(Path(sys.argv[0]).name))
        sys.exit(1)
    json_file = sys.argv[1]
    definition = primary.load_definition(json_file)

    target = k8s.first_server_node(definition)
    if not target:
        sys.exit(1)
    vm_name, _ssh_cmd = target

    clu_name = k8s.get_vm_kcluster(definition, vm_name)
    cfg = definition.get("milvus", {}) or {}
    online = definition.get("common", {}).get("online") == "1"

    setup_helm(vm_name, clu_name, online=online)
    repo, extra_set = "", ""
    if appco.from_appcollection(cfg, "milvus", appco.SOURCE_APPCOLLECTION):
        creds = ac.resolve_credential(cfg, "appcollection", {
            "milvus_appcollection_user": "appcollection_user",
            "milvus_appcollection_password": "appcollection_password",
        }, account_key="milvus_appcollection_account")
        user = creds["milvus_appcollection_user"]
        password = creds["milvus_appcollection_password"]
        if not user or not password:
            die("milvus: milvus_source is \"appcollection\", so milvus_appcollection_user and "
                "milvus_appcollection_password are needed — set them, set milvus_appcollection_account "
                "to an \"appcollection\" credential file, or leave all three unset with exactly "
                "one such file in the store (https://apps.rancher.io)")
        repo, extra_set = appco.prepare_appcollection_repo(
            vm_name, cfg.get("milvus_ns") or "milvus", user, password)
    else:
        setup_milvus_repo(vm_name, milvus_rel=cfg.get("milvus_rel"), milvus_repo_url=cfg.get("milvus_repo_url"))
    setup_milvus(vm_name, milvus_rel=repo or cfg.get("milvus_rel"), milvus_ns=cfg.get("milvus_ns"),
                 extra_set=extra_set, from_appcollection=bool(repo),
                 milvus_version=cfg.get("milvus_version"), milvus_cluster=cfg.get("milvus_cluster"))


if __name__ == "__main__":
    main()
