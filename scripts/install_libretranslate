#!/usr/bin/env python3.11
# Part of lab-in-a-box. Installs LibreTranslate, a self-hosted machine-translation API, as a podman container on a
# lab node, with the language models the lab asks for.
# Author/s: Raul Mahiques
# License: GPLv3
#
# References: https://github.com/LibreTranslate/LibreTranslate (AGPL-3.0), whose engine is Argos Translate. The
# image is libretranslate/libretranslate and it serves the API and a web UI on one port, 5000 by default. Every
# command-line argument has an environment variable of the same name, upper snake case with an LT prefix
# (--load-only is LT_LOAD_ONLY), which is how this add-on configures the container.
#
# Language models are what make this big: each pair is tens of megabytes, and "all" is every pair upstream
# publishes. They are downloaded on first boot into libretranslate_data_dir, which is a directory on the node and
# not a container volume, so a rebuilt container does not download them again.
#
# The service is reached at the node's own name, which the lab registered when it created the node, so this
# add-on registers no DNS record of its own.
#
# Schema version: 1.0
#
# JSON section: "libretranslate" — LibreTranslate, a self-hosted translation API
#   libretranslate_languages : the languages to load, as a list of codes ("en", "es", "de", ...), or the single
#                          string "all" for every language upstream supports. The codes are the ones on
#                          https://docs.libretranslate.com/guides/supported_languages/ and are listed in this
#                          script's LANGUAGES. English is always included: LibreTranslate pivots through it when
#                          there is no direct pair, so a set without it can translate almost nothing.
#                          (default: en, es)
#   libretranslate_image : container image (default: libretranslate/libretranslate)
#   libretranslate_image_tag : image tag (default: latest)
#   libretranslate_port  : the port it serves the API and the web UI on (default: 5000)
#   libretranslate_listen : the address on the node to publish that port on (default: 0.0.0.0)
#   libretranslate_data_dir : directory on the node holding the downloaded models
#                          (default: /var/lib/libretranslate)
#   libretranslate_update_models : "true" or "false" (default: false). Updates the models at every start, which
#                          costs a download each time the container restarts.
#   libretranslate_api_keys : "true" or "false" (default: false). Turns on the API-key database, which is what
#                          per-client limits need. With libretranslate_req_limit 0 it makes a key mandatory.
#   libretranslate_req_limit : requests per minute per client. Unset means no limit.
#   libretranslate_char_limit : characters per request. Unset means no limit.
#   libretranslate_disable_web_ui : "true" or "false" (default: false). Serves the API only.
#   libretranslate_threads : how many threads it translates with (default: 4)
#   libretranslate_wait  : seconds to wait for /languages before carrying on. The first boot downloads the models
#                          the lab asked for, and "all" is a long download, so this is generous; it only decides
#                          how long the lab waits, never whether the service was installed. (default: 900)
#   libretranslate_container_name : the container's name on the node (default: libretranslate)
#
# NOTE: a cluster deployment is not wired up here. Upstream publishes a Helm chart
# (https://libretranslate.github.io/helm-chart/), but this add-on configures nothing it has not pinned down, and
# one container on a node is what a lab needs from a translation API.

__version__ = "__LABVERSION__"

PLUGIN = {
    "name": "libretranslate",
    "targets": ["vm", "baremetal"],
    "layers": ["standalone-container"],
    "requires_kubernetes": None,
    "requires_cluster": [],
    "aux_services": [],
    "check": True,
}

import os
import sys
from pathlib import Path

for _candidate in ("/usr/local/lib/lab_creation", str(Path(__file__).resolve().parent.parent / "libs")):
    if Path(_candidate).is_dir() and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

import addon_common as ac  # noqa: E402
import k8s  # noqa: E402
import podman_service as ps  # noqa: E402
import primary  # noqa: E402
import shlex  # noqa: E402
from lab_creation import ssh_run, ssh_output, log, warn  # noqa: E402

DEFAULT_IMAGE = "libretranslate/libretranslate"
DEFAULT_TAG = "latest"
DEFAULT_PORT = 5000
DEFAULT_DATA = "/var/lib/libretranslate"
DEFAULT_NAME = "libretranslate"
DEFAULT_WAIT = 900
DEFAULT_LANGUAGES = ("en", "es")
ALL = "all"
PIVOT = "en"
# Where the image keeps the models it downloads; fixed by the image, not something a lab chooses.
CONTAINER_DATA = "/home/libretranslate/.local"

# Every language upstream publishes a model for, code to name. Kept here so a lab's codes can be checked before
# anything is downloaded, and so the web UI's field description can list them.
LANGUAGES = {
    "ar": "Arabic", "az": "Azerbaijani", "bg": "Bulgarian", "bn": "Bengali", "ca": "Catalan", "cs": "Czech",
    "da": "Danish", "de": "German", "el": "Greek", "en": "English", "eo": "Esperanto", "es": "Spanish",
    "et": "Estonian", "eu": "Basque", "fa": "Persian", "fi": "Finnish", "fr": "French", "ga": "Irish",
    "gl": "Galician", "he": "Hebrew", "hi": "Hindi", "hu": "Hungarian", "id": "Indonesian", "it": "Italian",
    "ja": "Japanese", "ko": "Korean", "ky": "Kyrgyz", "lt": "Lithuanian", "lv": "Latvian", "ms": "Malay",
    "nb": "Norwegian", "nl": "Dutch", "pb": "Portuguese (Brazil)", "pl": "Polish", "pt": "Portuguese",
    "ro": "Romanian", "ru": "Russian", "sk": "Slovak", "sl": "Slovenian", "sq": "Albanian", "sv": "Swedish",
    "th": "Thai", "tl": "Tagalog", "tr": "Turkish", "uk": "Ukrainian", "ur": "Urdu", "vi": "Vietnamese",
    "zh": "Chinese", "zt": "Chinese (traditional)",
}


def _get(cfg, field, default=""):
    value = (cfg or {}).get("libretranslate_{}".format(field))
    return default if value in ("", None) else value


def _truth(cfg, field, default):
    return str(_get(cfg, field, default)).strip().lower() == "true"


def name_of(cfg):
    return str(_get(cfg, "container_name", DEFAULT_NAME))


def port_of(cfg):
    return int(_get(cfg, "port", DEFAULT_PORT))


def image_of(cfg):
    return "{}:{}".format(_get(cfg, "image", DEFAULT_IMAGE), _get(cfg, "image_tag", DEFAULT_TAG))


def wants_all(cfg):
    """Whether the lab asked for every language, which is what upstream loads when nothing restricts it."""
    value = _get(cfg, "languages", list(DEFAULT_LANGUAGES))
    if isinstance(value, str):
        value = [value]
    return any(str(v).strip().lower() == ALL for v in value)


def languages_of(cfg):
    """
    The language codes to load, in LANGUAGES order so a run is the same whatever order a lab wrote them in, with
    English added because LibreTranslate pivots through it. Empty for "all", which is LibreTranslate's own
    default and needs no argument at all.
    """
    if wants_all(cfg):
        return []
    value = _get(cfg, "languages", list(DEFAULT_LANGUAGES))
    if isinstance(value, str):
        value = [v.strip() for v in value.split(",")]
    asked = {str(v).strip().lower() for v in value if str(v).strip()}
    asked.add(PIVOT)
    return [code for code in LANGUAGES if code in asked]


def unknown_languages(cfg):
    """The codes in libretranslate_languages that are neither a supported language nor "all"."""
    value = _get(cfg, "languages", [])
    if isinstance(value, str):
        value = [v.strip() for v in value.split(",")]
    return [str(v).strip() for v in (value or [])
            if str(v).strip() and str(v).strip().lower() not in LANGUAGES and str(v).strip().lower() != ALL]


def environment(cfg):
    """
    The LT_* variables the container is configured with. LT_HOST is always every address: that is the address
    inside the container, and its own default of 127.0.0.1 would make the published port answer nothing.
    """
    env = {"LT_HOST": "0.0.0.0", "LT_PORT": str(port_of(cfg)),
           "LT_THREADS": str(_get(cfg, "threads", 4))}
    codes = languages_of(cfg)
    if codes:
        env["LT_LOAD_ONLY"] = ",".join(codes)
    if _truth(cfg, "update_models", "false"):
        env["LT_UPDATE_MODELS"] = "true"
    if _truth(cfg, "api_keys", "false"):
        env["LT_API_KEYS"] = "true"
    if _truth(cfg, "disable_web_ui", "false"):
        env["LT_DISABLE_WEB_UI"] = "true"
    for field, variable in (("req_limit", "LT_REQ_LIMIT"), ("char_limit", "LT_CHAR_LIMIT")):
        value = _get(cfg, field, "")
        if str(value) != "":
            env[variable] = str(value)
    return env


def _validate(v):
    cfg = v.definition.get("libretranslate", {}) or {}
    value = cfg.get("libretranslate_languages")
    if value not in ("", None) and not isinstance(value, (list, str)):
        v.errors.append("[ERROR] libretranslate.libretranslate_languages must be a list of language codes, or "
                        "\"all\"")
    for code in unknown_languages(cfg):
        v.errors.append("[ERROR] libretranslate.libretranslate_languages: '{}' is not a language LibreTranslate "
                        "publishes a model for — use one of {}, or \"all\"".format(
                            code, ", ".join(sorted(LANGUAGES))))
    v.vport("libretranslate", "libretranslate_port")
    for field in ("libretranslate_api_keys", "libretranslate_update_models", "libretranslate_disable_web_ui"):
        v.vbool("libretranslate", field)
    for field in ("libretranslate_req_limit", "libretranslate_char_limit", "libretranslate_threads",
                  "libretranslate_wait"):
        value = cfg.get(field)
        if value not in ("", None) and not str(value).isdigit():
            v.errors.append("[ERROR] libretranslate.{}='{}': must be a number".format(field, value))


def setup_libretranslate(hostname, cfg):
    """Deploy the container, wait for the models it has to download, and say what it loaded."""
    name = name_of(cfg)
    port = port_of(cfg)
    data_dir = str(_get(cfg, "data_dir", DEFAULT_DATA))
    listen = str(_get(cfg, "listen", "0.0.0.0"))
    codes = languages_of(cfg)

    if codes:
        log("- Loading {} language(s): {}".format(len(codes), ", ".join(
            "{} ({})".format(LANGUAGES[c], c) for c in codes)))
    else:
        log("- Loading every language LibreTranslate publishes a model for, which is a download of several "
            "gigabytes on first boot")

    # The models live in a directory on the node, so a rebuilt container finds them already there. The image runs
    # as its own non-root user, which has to be able to write into it.
    ssh_run(hostname, "mkdir -p {d} && chmod 0777 {d}".format(d=shlex.quote(data_dir)))
    ps.deploy(hostname, name, image_of(cfg),
              description="LibreTranslate (lab-in-a-box)",
              ports=["{}:{}:{}".format(listen, port, port)],
              env=environment(cfg),
              volumes=["{}:{}".format(data_dir, CONTAINER_DATA)])

    ready = ps.wait_for_http(hostname, "http://127.0.0.1:{}/languages".format(port),
                            timeout=int(_get(cfg, "wait", DEFAULT_WAIT)), what="LibreTranslate")
    if ready:
        log("- LibreTranslate API: http://{}:{}/translate   web UI: http://{}:{}/".format(
            hostname, port, hostname, port))
    else:
        warn("- It is still downloading models, most likely. Watch 'podman logs {}' on {}".format(name, hostname))


def _check(chk):
    """That the container runs the image the lab asked for, and that it answers with the languages it loaded."""
    if "libretranslate" not in chk.definition:
        chk.ok("this lab has no libretranslate section, so there is nothing to check")
        return
    cfg = chk.definition.get("libretranslate", {}) or {}
    name = name_of(cfg)

    if not ps.is_running(chk.vm_name, name):
        chk.fail("the {} container on {}".format(name, chk.vm_name), "running", "not running")
        return
    chk.ok("the {} container is running on {}".format(name, chk.vm_name))
    running = ps.container_image(chk.vm_name, name)
    if running:
        chk.expect("the image {} runs".format(name), image_of(cfg), running)

    answered = ssh_output(chk.vm_name, "curl -fsS http://127.0.0.1:{}/languages 2>/dev/null".format(port_of(cfg)))
    if not answered.strip():
        chk.fail("the /languages endpoint on port {}".format(port_of(cfg)), "answers", "does not answer")
        return
    chk.ok("it answers on port {}".format(port_of(cfg)))
    missing = [code for code in languages_of(cfg) if '"{}"'.format(code) not in answered]
    if missing:
        chk.fail("the languages it loaded", "including {}".format(", ".join(missing)), "without them")
    else:
        chk.ok("every language the lab asked for is loaded")


def main():
    ac.handle_common_args(__file__, __version__, validate_fn=_validate, plugin=PLUGIN, check_fn=_check)

    if len(sys.argv) < 2:
        print("Usage: {} <lab-file>".format(Path(sys.argv[0]).name))
        sys.exit(1)
    definition = primary.load_definition(sys.argv[1])
    env_vm_name = os.environ.get("_vm_name") or None
    for vm_name, _ssh_cmd in k8s.addon_nodes(definition, "libretranslate", vm_name=env_vm_name):
        setup_libretranslate(vm_name, k8s.addon_node_config(definition, "libretranslate", vm_name))


if __name__ == "__main__":
    main()
