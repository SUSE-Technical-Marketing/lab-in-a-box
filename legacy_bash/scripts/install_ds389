_VERSION="bac232b"
# JSON section: "ds389" — 389 Directory Server (LDAP) on Kubernetes
#
#   ds389_admin_user    : [OPTIONAL] Directory Manager DN              (default: cn=Directory Manager)
#   ds389_admin_pwd     : [OPTIONAL] Directory Manager password        (default: auto-generated)
#   ds389_ldap_user     : [OPTIONAL] Sample LDAP username             (default: ldap_user)
#   ds389_ldap_user_pwd : [OPTIONAL] Sample LDAP user password        (default: auto-generated)
#   ds389_ns            : [OPTIONAL] Kubernetes namespace              (default: ds389)
#   ds389_version       : [OPTIONAL] Helm chart version               (empty = latest)

[[ "${1}" == "--version" || "${1}" == "-v" ]] && echo "${0##*/} ${_VERSION}" && exit 0
if [[ "${1}" == "--validate" ]]; then
    _vf="${2}" _ve=0
    _vreq() { local _v; _v=$(jq -r ".${1}.${2} // \"\""  < "${_vf}" 2>/dev/null); [[ -n "${_v}" ]] || { echo "[ERROR] ${1}.${2} is required (no default)"; ((_ve++)); }; }
    _vns()  { local _v; _v=$(jq -r ".${1}.${1}_ns // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[a-z0-9][a-z0-9-]{0,62}$' || { echo "[ERROR] ${1}.${1}_ns='${_v}': invalid namespace (lowercase, alphanumeric, hyphens only)"; ((_ve++)); }; }
    _vver() { local _v; _v=$(jq -r ".${1}.${1}_version // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+\.[0-9]' || { echo "[ERROR] ${1}.${1}_version='${_v}': not a valid version (expected X.Y…)"; ((_ve++)); }; }
    _vurl() { local _v; _v=$(jq -r ".${1}.${1}_repo_url // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^https?://' || { echo "[ERROR] ${1}.${1}_repo_url='${_v}': must start with https://"; ((_ve++)); }; }
    _vbool(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" || "${_v}" == "true" || "${_v}" == "false" ]] || { echo "[ERROR] ${1}.${2}='${_v}': must be 'true' or 'false'"; ((_ve++)); }; }
    _vport(){ local _v; _v=$(jq -r ".${1}.${2} // \"\"" < "${_vf}" 2>/dev/null); [[ -z "${_v}" ]] || echo "${_v}" | grep -qE '^[0-9]+$' || { echo "[ERROR] ${1}.${2}='${_v}': must be a port number"; ((_ve++)); }; }
    exit ${_ve}
fi

if [[ "${1}" == "--help" ]]; then
    echo "Usage: ${0##*/} <lab.json> [<vm_name>]"
    echo ""
    awk '/# (─+ *)?JSON section:/{p=1} p && /^[^#]/{exit} p{sub(/^# ?/,""); print}' "$0"
    exit 0
fi
if [[ "${1}" == "--input-definition" || "${1}" == "--schema" ]]; then
    lab_schema "$0" "${2:-json}"
    exit $?
fi


# load lab_creation defaults
if [[ -f /etc/lab_creation.defaults ]]
then
        . /etc/lab_creation.defaults
elif [[ -f lab_creation.defaults ]]
then
        . lab_creation.defaults
else
        echo "ERROR: Configuration file lab_creation.defaults not found in local path or /etc"
        exit 1
fi

# Load primary functions
. ${_primary_funtions} || exit 1

# load Kubernetes functions
. ${_lib_path}/k8s_functions.bash


ds389_admin_user="cn=Directory Manager"
ds389_admin_pwd="$(tr -dc '[:alnum:]' </dev/urandom | head -c 13; echo '69')"
ds389_ldap_hostname="ldap.${HOSTNAME}.${_SANDBOX_ID}.instruqt.io"
ds389_ldap_port="30389"
ds389_uri="ldap://${_ldap_hostname}:${_ldap_port}"

ds389_connection_str="-D \"${_admin_user}\" -w \"${_admin_pwd}\" -x  -H \"${_uri}\""
ds389_basedn="dc=spacestation,dc=lab"
ds389_ldap_user_dn="uid=ldap_user,ou=people,${_basedn}"
ds389_ldap_user_pwd="$(tr -dc '[:alnum:]' </dev/urandom | head -c 13; echo '69')"
ds389_type=ds389
ds389_dm_pwd_b64="`echo ${_admin_pwd} | base64 -w 0`"
ds389_ns_name="ds389"
ds389_rootdn="${_basedn}"
ds389_dm_pwd="${_admin_pwd}"
ds389_users_pwd="${_ldap_user_pwd}"




 # Setup 389
function setup_ds389() {
                $ssh_command "zypper install -y open-iscsi cryptsetup; systemctl enable --now iscsid.service ; modprobe iscsi_tcp"
                $ssh_command "kubectl create namespace longhorn-system"
                $ssh_command "helm upgrade -i longhorn longhorn/longhorn --namespace longhorn-system --set ingress.enabled=true --set ingress.host=${lh_shorthn:-longhorn}.${clu_name}.${mydomain}  --set persistence.migratable=true --set longhornUI.replicas=1"
                echo "Longhorn should be available in a few minutes in: ${lh_shorthn:-longhorn}.${clu_name}.${mydomain}"
}
 






# Setup mariadb
function setup_mariadb() {

                $ssh_command "kubectl delete -n ${mariadb_ns:-db} deployment.apps/${mariadb_name:-mariadb} service/${mariadb_name:-mariadb}"
                template_file=${_templ_addons_loc}/mariadb/install.yml.tmpl
                process_templates | $ssh_command "kubectl apply -f -"
}


# load cluster vars
load_kclu_vars

# load rancher variables
load_rancher_vars

# load ds389 variables
load_ds389_vars


load_vm_vars
ssh_command="ssh  -o StrictHostKeyChecking=accept-new -q  root@${_vm_name}"
_msg="# Using node: \e[1;91m\"${_vm_name}\"\e[0m" show_nicer_messages
setup_ds389
sleep 60
exit 1

