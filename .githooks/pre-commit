#!/bin/bash
# Restore __LABVERSION__ placeholder in any staged scripts before committing
# Prevents expanded commit hashes from being stored in the repository

_repo_root=$(git rev-parse --show-toplevel)
_changed=0

while IFS= read -r _file; do
    [[ -f "${_repo_root}/${_file}" ]] || continue
    if grep -q -E '(_VERSION="|__version__ = ")[0-9a-f]{7,}"' "${_repo_root}/${_file}"; then
        sed -i -E 's/(_VERSION="|__version__ = ")[0-9a-f]{7,}"/\1__LABVERSION__"/' "${_repo_root}/${_file}"
        git add "${_repo_root}/${_file}"
        _changed=1
    fi
done < <(git diff --cached --name-only | grep '^scripts/')

if [[ ${_changed} -eq 1 ]]; then
    echo "info: restored __LABVERSION__ placeholder in staged scripts"
fi

# ── Automated tests — every check runs inside a disposable podman container
# (tests/Containerfile), never on the host directly. See tests/run_tests.sh.
# Skip for one commit if truly needed: git commit --no-verify
# A commit that only touches documentation or media (no code, tests, templates,
# or webui) has nothing to test, so the suite is skipped for it.
_code_changed=0
while IFS= read -r _file; do
    case "${_file}" in
        *.md|docs/*|media/*) ;;
        *) _code_changed=1; break ;;
    esac
done < <(git diff --cached --name-only)
if [[ ${_code_changed} -eq 0 ]]; then
    echo "pre-commit: only documentation/media staged — skipping the test suite" >&2
    exit 0
fi

if ! command -v podman >/dev/null 2>&1; then
    echo "pre-commit: podman not found — skipping containerized tests (install podman to enable them)" >&2
    exit 0
fi

# Scope the suite to what's actually staged (tests/select_checks.py): a check that declares no
# dependency still always runs, so this is additive-safe, not a narrower gate than before.
TESTS_CHANGED_FILES="$(git diff --cached --name-only)" "${_repo_root}/tests/run_tests.sh" || exit 1

# install_demo_server_scripts.sh's own multi-OS test (tests/install_test/run.sh) pulls several
# external OS images and runs real package installs — slow and network-dependent, so it only
# runs when a file on the install path actually changed, not on every commit.
_install_changed=0
while IFS= read -r _file; do
    case "${_file}" in
        install_demo_server_scripts.sh|install_automation_node_scripts.sh| \
        setup_demo_server/*|libs/kvm_host_profiles.py|tests/install_test/*) _install_changed=1; break ;;
    esac
done < <(git diff --cached --name-only)
if [[ ${_install_changed} -eq 1 ]]; then
    echo "pre-commit: install-path files changed — running tests/install_test/run.sh (real OS images)" >&2
    "${_repo_root}/tests/install_test/run.sh"
fi
